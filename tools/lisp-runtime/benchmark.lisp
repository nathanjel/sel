;;;; SEL_LISP_RUNTIME_ROOT selects a complete source tree. JSON on stdout.
(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(let ((*standard-output* (make-broadcast-stream))
      (root (uiop:ensure-directory-pathname (or (uiop:getenv "SEL_LISP_RUNTIME_ROOT") "./"))))
  (asdf:load-asd (truename (merge-pathnames "lisp/sel-lang.asd" root)))
  (funcall (find-symbol "QUICKLOAD" "QL") '(:sel-lang :yason)))
(defvar *sink*)
(defvar *results* (make-hash-table :test 'equal))
(defun measure (name count fn)
  (dotimes (i 100) (setf *sink* (funcall fn)))
  (let ((samples nil))
    (dotimes (sample 7)
      (sb-ext:gc :full t)
      (let ((start (get-internal-real-time)) (bytes (sb-ext:get-bytes-consed)))
        (dotimes (i count) (setf *sink* (funcall fn)))
        (let ((r (make-hash-table :test 'equal)))
          (setf (gethash "us" r) (/ (* 1d6 (- (get-internal-real-time) start))
                                    (* count internal-time-units-per-second))
                (gethash "bytes" r) (/ (- (sb-ext:get-bytes-consed) bytes) (float count 1d0)))
          (push r samples))))
    (setf (gethash name *results*) (coerce (nreverse samples) 'vector))))
(let* ((leaf (sel:make-text "1"))
       (row (sel::%make-shaped-value (sel::get-record-shape '("id")) (vector leaf))))
  (measure "alias-fixed" 200000 (lambda () (sel::ensure-row-table-alias row "ORDERS")))
  (let ((i 0))
    (measure "alias-alternating" 200000
             (lambda () (sel::ensure-row-table-alias row (if (oddp (incf i)) "ORDERS" "CUSTOMERS")))))
  (let ((i 0))
    (measure "alias-changing" 5000
             (lambda () (sel::ensure-row-table-alias row (format nil "TABLE_~d" (incf i))))))
  (let ((i 0))
    (measure "alias-shape-changing" 5000
             (lambda ()
               (sel::ensure-row-table-alias
                (sel::%make-shaped-value
                 (sel::get-record-shape (list "id" (format nil "field_~d" (incf i))))
                 (vector leaf leaf)) "ORDERS")))))
(let ((ctx (sel::make-context (sel:make-none))))
  (measure "node-construction" 100000 (lambda () (sel::make-node :call nil)))
  (dolist (n '(2 10 100))
    (let ((node (sel::make-node :call nil)) (literal (sel::make-node :text nil)))
      (setf (sel::node-items node) (make-list n :initial-element literal))
      (measure (format nil "args-~d" n) 100000 (lambda () (sel::make-args node ctx))))))
(let* ((program (sel:compile-source "MAP(XS, RECORD(\"id\", _, \"next\", _ + 1))"))
       (ctx (sel:make-none)))
  (sel:value-set ctx "XS" (sel:make-list-value (loop for i below 1000 collect (sel:make-text (write-to-string i)))))
  (measure "projection-1000" 100 (lambda () (sel:run program ctx))))
(let* ((program (sel:compile-source "COALESCE(A, B, C)")) (ctx (sel:make-none)))
  (sel:value-set ctx "A" (sel:make-none))
  (sel:value-set ctx "B" (sel:make-none))
  (sel:value-set ctx "C" (sel:make-text "value"))
  (measure "coalesce-3" 100000 (lambda () (sel:run program ctx)))
  (measure "compile-and-run" 5000
           (lambda () (sel:run (sel:compile-source "COALESCE(A, B, C)") ctx))))
(yason:encode *results* *standard-output*)
(terpri)
