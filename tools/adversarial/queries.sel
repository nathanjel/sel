R .> BUCKET(_["cat"], RECORD("cat", _K, "n", COUNT(_)))
R .> FILTER(_["cat"] $== "a") .> MAP(RECORD("id", _["id"]))
R .> MAP(RECORD("ratio", _["id"] / _["fk"]))
R .> MAP(RECORD("ratio", _["v"] / _["fk"]))
R .> LINK_LEFT(S, _1["fk"] == _2["id"]) .> MAP(RECORD("cat", _["S"]["cat"]))
R .> BUCKET(LIST(_["cat"], _["fk"]), RECORD("n", COUNT(_)))
R .> BUCKET(_["cat"] + 0, RECORD("key", _K, "n", COUNT(_)))
R .> MAP(RECORD("x", _["id"], "x", _["fk"]))
R .> SORT_BY(_["id"]) .> TAKE(2) .> DROP(1) .> MAP(RECORD("id", _["id"]))
R .> SORT_BY(_["id"]) .> TAKE(1) .> TAKE(2) .> MAP(RECORD("id", _["id"]))
R .> FILTER(_["cat"] + 0 > 0) .> MAP(RECORD("id", _["id"]))
R .> MAP(RECORD("v", _["v"] / _["fk"]))
R .> MAP(RECORD("x", _["id"], "x", _["fk"])) .> FILTER(_["x"] > 5)
R .> LINK(S, _1["fk"] == _2["id"]) .> SORT_BY(_["R"]["id"]) .> TAKE(2) .> DROP(1) .> MAP(RECORD("id", _["R"]["id"], "dimension", _["S"]["cat"]))
R .> LINK(S, _1["fk"] == _2["fk"]) .> FILTER(_["R"]["cat"] $== "color" AND _["S"]["cat"] $== "dimension") .> MAP(RECORD("entity", _["R"]["fk"]))
R .> MAP(RECORD("x", _["id"], "x", _["fk"])) .> TAKE(1) .> FILTER(_["x"] > 5)
R .> SORT_BY(_["id"]) .> DROP(1) .> DROP(1) .> MAP(RECORD("id", _["id"]))
R .> SORT_BY(_["id"]) .> TAKE(1) .> DROP(2) .> MAP(RECORD("id", _["id"]))
R .> FILTER(BACKWARDS(_["cat"]) $== "a") .> TAKE(1)
R .> BUCKET(_["fk"]) .> MAP(RECORD("entity", _K, "latest", TOP_BY(_, _["id"], "DESC", 1)))
