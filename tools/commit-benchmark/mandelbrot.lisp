(require :asdf)
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(push (truename "lisp/") asdf:*central-registry*)
(ql:quickload '(:sel-lang :yason) :silent t)
(let* ((source (uiop:read-file-string "examples/mandelbrot.sel"))
       (start (get-internal-real-time)) (program (sel:compile-source source))
       (compile-ms (* 1000d0 (/ (- (get-internal-real-time) start) internal-time-units-per-second)))
       (warmups (parse-integer (or (uiop:getenv "MANDEL_WARMUPS") "2")))
       (runs (parse-integer (or (uiop:getenv "MANDEL_RUNS") "5")))
       (samples nil) (outputs nil) (report (make-hash-table :test 'equal)))
  (dotimes (i (+ warmups runs))
    (let* ((t0 (get-internal-real-time)) (result (sel:run program (sel:make-none)))
           (output (sel:as-text result))
           (ms (* 1000d0 (/ (- (get-internal-real-time) t0) internal-time-units-per-second))))
      (when (>= i warmups) (push ms samples) (push output outputs))))
  (setf (gethash "warmups" report) warmups (gethash "runs" report) runs (gethash "compile_ms" report) compile-ms (gethash "samples_ms" report) (coerce (reverse samples) 'vector)
        (gethash "outputs" report) (coerce (reverse outputs) 'vector))
  (with-open-file (s (uiop:getenv "MANDEL_OUTPUT") :direction :output :if-exists :supersede)
    (yason:encode report s)))
