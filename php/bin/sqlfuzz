#!/usr/bin/env php
<?php
// Translate a corpus of SEL programs and print one canonical line each.
//
//   php php/bin/sqlfuzz corpus.selc [dialect]
//
// The counterpart of js/bin/sqlfuzz.mjs and python/bin/sqlfuzz; see the first
// for why this lane exists. The corpus format and the one-line-per-program
// protocol are specified in tools/README.md.

declare(strict_types=1);

require_once __DIR__ . '/../src/Sql/bootstrap.php';
require_once __DIR__ . '/harness.php';

use Sel\Sel;
use Sel\SelError;
use Sel\Sql\Binding;
use Sel\Sql\Sql;
use Sel\Sql\SqlError;

use function SelBin\read_corpus;
use function SelBin\read_file_or_exit;

$path = $argv[1] ?? null;
$dialect = $argv[2] ?? 'mariadb';
// `statement`: only translateStatement's inline SQL; see js/bin/sqlfuzz.mjs.
$mode = $argv[3] ?? 'all';
if ($path === null) {
    fwrite(STDERR, "usage: sqlfuzz corpus.selc [dialect] [all|statement]\n");
    exit(2);
}

// The relations the corpus's pipelines read (tools/gen-programs.mjs --sql), the
// same in every host's runner: two tables, a NUM join key, a TEXT field whose
// name both sides share.
$bindings = [
    'ORDERS' => Binding::relation('orders', 'o', [
        'ID' => Binding::column('id', 'o', 'NUM'), 'CUSTOMER_ID' => Binding::column('customer_id', 'o', 'NUM'),
        'AMOUNT' => Binding::column('amount', null, 'NUM'), 'NAME' => Binding::column('name', 'o', 'TEXT')]),
    'CUSTOMERS' => Binding::relation('customers', 'c', [
        'ID' => Binding::column('id', 'c', 'NUM'), 'NAME' => Binding::column('name', 'c', 'TEXT')]),
];
$render = static fn ($f): string => implode(' | ', [
    $f->asValue(), $f->asValue('params'),
    implode(',', array_map(fn ($v) => $v->dump(), $f->bindings())),
]);
// Three lanes per program, `||`-separated: translate(), translateStatement()
// and planHybrid() (its classification, then its statement in params mode).
$attempt = static function (callable $fn): string {
    try {
        return $fn();
    } catch (SqlError $e) {
        return "!{$e->code}@{$e->line}:{$e->col}";
    } catch (SelError $e) {
        return "!SEL {$e->code}@{$e->line}:{$e->col}";
    } catch (\Throwable $e) {
        return '!HOST ' . get_class($e) . ': ' . $e->getMessage();
    }
};
// Exactly one trailing newline comes off each record; a CR anywhere is program
// text. A path that cannot be read, or a corpus with no record, is a refusal.
$corpus = read_corpus(read_file_or_exit($path));
if ($corpus === []) {
    fwrite(STDERR, "no programs in {$path}\n");
    exit(1);
}
$lines = [];
foreach ($corpus as $src) {
    try {
        $program = Sel::compile($src);
    } catch (SelError $e) {
        $lines[] = '-';
        continue;
    } catch (\Throwable $e) {
        $lines[] = '!HOST ' . get_class($e);
        continue;
    }
    if ($mode === 'statement') {
        $lines[] = $attempt(static fn () => Sql::translateStatement($program, $dialect, $bindings)->asStatement());
        continue;
    }
    // Three renderings; see js/bin/sqlfuzz.mjs for why. $attempt turns every
    // outcome of each into its line, so nothing escapes to this loop.
    $lines[] = implode(' || ', [
        $attempt(static fn () => $render(Sql::translate($program, $dialect, $bindings))),
        $attempt(static fn () => $render(Sql::translateStatement($program, $dialect, $bindings))),
        $attempt(static function () use ($program, $dialect, $bindings): string {
            $plan = Sql::planHybrid($program, $dialect, $bindings);
            $kind = $plan->kind();
            return $plan->sqlStatement ? "$kind " . $plan->sqlStatement->asStatement('params') : $kind;
        }),
    ]);
}

echo implode("\n", array_map(fn ($l) => str_replace("\n", '\\n', $l), $lines)), "\n";
