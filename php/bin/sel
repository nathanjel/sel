#!/usr/bin/env php
<?php
// SEL command line: evaluate an expression, a file, or start a REPL. The
// contract every host's CLI keeps is in docs/usage/repl.md.
//
//   sel -e 'EXPR'          evaluate and print
//   sel file.sel           evaluate a file
//   sel --deps -e 'EXPR'   print the variables the expression reads, one per line
//   sel                    REPL on stdin, keeping one context across lines
//   sel --help | --version

declare(strict_types=1);

require_once __DIR__ . '/../src/bootstrap.php';

use Sel\Sel;
use Sel\SelError;
use Sel\Value;

function show(Value $v): string
{
    if ($v->size() === 0) {
        if ($v->kind === Value::TEXT) {
            return (string) $v->scalar;
        }
        if ($v->kind === Value::BOOL) {
            return $v->scalar ? 'TRUE' : 'FALSE';
        }
        if ($v->kind === Value::BIN) {
            return 'bin:' . bin2hex((string) $v->scalar);
        }
    }
    return $v->dump();
}

function report(SelError $e): void
{
    fwrite(STDERR, "{$e->code} at line {$e->line} column {$e->col}: {$e->getMessage()}\n");
}

const USAGE = <<<'TXT'
usage: sel -e EXPR          evaluate EXPR and print the result
       sel FILE             evaluate the program in FILE
       sel --deps -e EXPR   print the variables EXPR reads, one per line
       sel --deps FILE      the same for the program in FILE
       sel                  read programs from stdin, one per line (a REPL)
       sel --help           this text
       sel --version        the version

TXT;

// Misuse is a controlled refusal: one plain line on stderr, nothing on stdout,
// exit status 2 -- never a PHP warning or a status of 255.
function usage(string $message): never
{
    fwrite(STDERR, "sel: {$message}\n");
    exit(2);
}

$args = array_slice($argv, 1);
$wantDeps = false;
$expr = null;
$file = null;
for ($i = 0, $n = count($args); $i < $n; $i++) {
    $arg = $args[$i];
    if ($arg === '--help' || $arg === '-h') {
        echo USAGE;
        exit(0);
    }
    if ($arg === '--version') {
        echo 'sel ', Sel::VERSION, "\n";
        exit(0);
    }
    if ($arg === '--functions') {
        echo implode("\n", Sel::functionNames()), "\n";
        exit(0);
    }
    if ($arg === '--deps') {
        $wantDeps = true;
        continue;
    }
    if ($arg === '-e') {
        if ($i + 1 >= $n) usage('-e needs an expression');
        // A second program: the expression is the extra operand (docs/usage/repl.md).
        if ($expr !== null || $file !== null) usage("unexpected argument {$args[$i + 1]}");
        $expr = $args[++$i];
        continue;
    }
    if (strlen($arg) > 1 && $arg[0] === '-') usage("unknown option {$arg}");
    if ($expr !== null || $file !== null) usage("unexpected argument {$arg}");
    $file = $arg;
}

$source = $expr;
if ($file !== null) {
    // Missing, unreadable or a directory: exit 1, like any other failure to run.
    $source = is_file($file) && is_readable($file) ? @file_get_contents($file) : false;
    if ($source === false) {
        fwrite(STDERR, "sel: cannot read {$file}\n");
        exit(1);
    }
}

if ($source !== null) {
    try {
        $program = Sel::compile($source);
        if ($wantDeps) {
            foreach ($program->dependencies() as $name) echo $name, "\n";
        } else {
            echo show($program->run(Value::none())), "\n";
        }
    } catch (SelError $e) {
        report($e);
        exit(1);
    }
    exit(0);
}
if ($wantDeps) usage('--deps needs -e EXPR or a FILE');

// REPL: one context for the whole session, so assignments persist. The prompt
// is for a person; on a pipe only results and errors are written.
$tty = stream_isatty(STDIN);
$useReadline = $tty && function_exists('readline');
$root = Value::none();
while (true) {
    if ($useReadline) {
        $line = readline('sel> ');
    } else {
        if ($tty) {
            echo 'sel> ';
        }
        $line = fgets(STDIN);
        if ($line !== false && str_ends_with($line, "\n")) {
            $line = substr($line, 0, -1);
        }
    }
    if ($line === false) {
        if ($tty) echo "\n";
        break;
    }
    // Blank means SEL whitespace only (space, TAB, CR, LF): a line of NBSP or
    // VT is a program, and an E_SYNTAX one.
    if (strspn($line, " \t\r\n") === strlen($line)) {
        continue;
    }
    if ($useReadline) readline_add_history($line);
    try {
        echo show(Sel::compile($line)->run($root)), "\n";
    } catch (SelError $e) {
        report($e);
    }
}
