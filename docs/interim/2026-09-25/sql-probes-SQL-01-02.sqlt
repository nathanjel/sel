### name: zprobe.p06-filter-first
--- dialect
sqlite
--- bindings
{"R": {"kind": "relation", "from": "r", "alias": "r", "fields": {"ID": {"column": "id", "type": "NUM"}, "VAL": {"column": "val", "type": "NUM"}}}, "S": {"kind": "relation", "from": "s", "alias": "s", "fields": {"ID": {"column": "id", "type": "NUM"}, "VAL": {"column": "val", "type": "NUM"}}}}
--- as
statement
--- source
R .> LINK(S, A, B, A["ID"] == B["ID"]) .> FILTER(_["A"]["VAL"] > 5) .> MAP(RECORD("picked", _["B"]["VAL"]))
--- expect
SELECT "s"."val" AS "picked" FROM "r" "r" INNER JOIN "s" "s" ON (CAST("r"."id" AS NUMERIC) = CAST("s"."id" AS NUMERIC)) WHERE ("r"."val" > 5)
===
### name: zprobe.p07-relation-name
--- dialect
sqlite
--- bindings
{"R": {"kind": "relation", "from": "r", "alias": "r", "fields": {"ID": {"column": "id", "type": "NUM"}, "VAL": {"column": "val", "type": "NUM"}}}, "S": {"kind": "relation", "from": "s", "alias": "s", "fields": {"ID": {"column": "id", "type": "NUM"}, "VAL": {"column": "val", "type": "NUM"}}}}
--- as
statement
--- source
R .> LINK(S, _1["ID"] == _2["ID"]) .> MAP(RECORD("picked", _["R"]["VAL"], "other", _["S"]["VAL"]))
--- expect
SELECT "r"."val" AS "picked", "s"."val" AS "other" FROM "r" "r" INNER JOIN "s" "s" ON (CAST("r"."id" AS NUMERIC) = CAST("s"."id" AS NUMERIC))
===
