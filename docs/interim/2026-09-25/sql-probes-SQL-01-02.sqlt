### name: zprobe.p01-ss-left
--- dialect
sqlite
--- bindings
{"R": {"kind": "relation", "from": "r", "alias": "r", "fields": {"ID": {"column": "id", "type": "NUM"}, "VAL": {"column": "val", "type": "NUM"}}}, "S": {"kind": "relation", "from": "s", "alias": "s", "fields": {"ID": {"column": "id", "type": "NUM"}, "VAL": {"column": "val", "type": "NUM"}}}}
--- as
statement
--- source
R .> LINK(S, SS, X, SS["ID"] == X["ID"]) .> MAP(RECORD("picked", _["SS"]["VAL"]))
--- expect
SELECT "r"."val" AS "picked" FROM "r" "r" INNER JOIN "s" "s" ON (CAST("r"."id" AS NUMERIC) = CAST("s"."id" AS NUMERIC))
===
