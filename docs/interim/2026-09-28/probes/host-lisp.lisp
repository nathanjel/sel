(in-package #:cl-user)
(defmacro probe (name &body body)
  `(format t "~38a ~a~%" ,name
           (handler-case (let ((r (progn ,@body)))
                           (if (typep r 'sel::value) (let ((d (sel:value-dump r))) (format nil "OK ~a" (subseq d 0 (min 80 (length d))))) (format nil "OK ~s" r)))
             (sel::sel-error (e) (format nil "ERR ~a" (sel:sel-error-code e)))
             (error (e) (format nil "ERR CL ~a ~a" (type-of e) (let ((s (princ-to-string e))) (subseq s 0 (min 60 (length s)))))))))
;; reported: to-native shares key strings
(let* ((p (sel:compile-source "RECORD(\"foo\", \"x\")"))
       (v (sel:run p))
       (n (sel:to-native v)))
  (probe "to-native alist [initial]" n)
  (setf (char (car (first n)) 0) #\b)
  (probe "value after mutating key" v)
  (probe "same program re-run" (sel:run p))
  (probe "fresh RECORD(\"foo\",..)[\"foo\"]" (sel:run (sel:compile-source "RECORD(\"foo\", \"x\")[\"foo\"]")))
  (probe "fresh RECORD(\"foo\",..)[\"boo\"]" (sel:run (sel:compile-source "RECORD(\"foo\", \"x\")[\"boo\"]"))))
;; children path (non-shaped record)
(let* ((v (sel:make-none)))
  (sel:value-set v "kk" (sel:make-text "1"))
  (let ((n (sel:to-native v))) (setf (char (car (first n)) 0) #\z))
  (probe "children path: after mutating key" v))
;; value-set keeps caller's key string?
(let* ((k (copy-seq "ab")) (v (sel:make-none)))
  (sel:value-set v k (sel:make-text "1"))
  (setf (char k 0) #\z)
  (probe "value-set: mutate caller key after" v))
;; from-native keys copied [control]
(let* ((k (copy-seq "ab")) (v (sel:from-native (list (cons k "1")))))
  (setf (char k 0) #\z)
  (probe "from-native: mutate key after [ctl]" v))
;; text / bin copies [control]
(let* ((s (copy-seq "ab")) (v (sel:make-text s))) (setf (char s 0) #\z) (probe "make-text copy [ctl]" v))
(let* ((v (sel:make-text "ab")) (n (sel:to-native v))) (setf (char n 0) #\z) (probe "to-native text copy [ctl]" v))
;; make-list-value retains caller vector
(let* ((vec (vector (sel:make-text "1"))) (v (sel:make-list-value vec)))
  (setf (svref vec 0) (sel:make-text "X"))
  (probe "make-list-value: mutate caller vec" v))
(let* ((lst (list (sel:make-text "1"))) (v (sel:make-list-value lst)))
  (setf (first lst) (sel:make-text "X"))
  (probe "make-list-value: mutate caller list" v))
;; make-num with over-cap / malformed dec
(probe "make-num dec scale 1000001" (sel:make-num (sel::dec-make nil 1 1000001)))
(probe "make-num dec 10^1000001 int" (sel:make-num (sel::dec-make nil (expt 10 1000001) 0)))
(probe "make-num dec neg digits" (sel:make-num (sel::%make-dec nil -5 0)))
(probe "make-num dec neg zero (raw)" (sel:make-num (sel::%make-dec t 0 0)))
(probe "make-num dec negative scale" (sel:make-num (sel::dec-make nil 7 -1)))
(probe "make-num string 1e6+1 [ctl]" (sel:make-num (make-string 1000001 :initial-element #\1)))
;; native ints
(probe "make-int 10^1000000 [ctl]" (sel:make-int (expt 10 1000000)))
(probe "from-native 10^1000000 [ctl]" (sel:from-native (expt 10 1000000)))
(probe "run ctx X=10^1000000" (sel:run (sel:compile-source "LEN(X)") (list (cons "X" (expt 10 1000000)))))
;; keys
(let ((lone (coerce (list #\a (code-char #xD800)) 'string)))
  (probe "make-text lone [ctl]" (sel:make-text lone))
  (probe "from-native lone key [ctl]" (sel:from-native (list (cons lone "1"))))
  (probe "value-set lone key [ctl]" (sel:value-set (sel:make-none) lone (sel:make-text "1"))))
;; bin
(probe "make-bin (t)" (sel:make-bin (list t)))
(probe "make-bin (1.0)" (sel:make-bin (list 1.0)))
