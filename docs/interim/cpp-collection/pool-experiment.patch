+// Cache raw storage only: Collection's destructor releases all vectors, maps
+// and shape owners before a block enters this bounded per-thread cache.
+struct CollectionFreelist {
+  struct Block { Block* next; };
+  Block* head = nullptr;
+  std::size_t count = 0;
+  static constexpr std::size_t MAX_CACHED = 2048;
+  ~CollectionFreelist() {
+    while (head) {
+      Block* next = head->next;
+      ::operator delete(head);
+      head = next;
+    }
+  }
+};
+thread_local CollectionFreelist tl_collection_freelist;
 }  // namespace
 
+void* Value::Collection::operator new(std::size_t size) {
+  if (size == sizeof(Collection) && tl_collection_freelist.head) {
+    auto* block = tl_collection_freelist.head;
+    tl_collection_freelist.head = block->next;
+    --tl_collection_freelist.count;
+    return block;
+  }
+  return ::operator new(size);
+}
+
+void Value::Collection::operator delete(void* ptr, std::size_t size) noexcept {
+  if (size == sizeof(Collection) && ptr &&
+      tl_collection_freelist.count < CollectionFreelist::MAX_CACHED) {
+    auto* block = ::new (ptr) CollectionFreelist::Block{tl_collection_freelist.head};
+    tl_collection_freelist.head = block;
+    ++tl_collection_freelist.count;
+    return;
+  }
+  ::operator delete(ptr);
+}
