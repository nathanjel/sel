+void test_collection_pool() {
+  selt::section("collection allocation lifetime");
+  // Exceed the cache bound while keeping every allocation live, then destroy
+  // them together. Cached raw blocks must not retain their payload owners.
+  std::vector<std::unique_ptr<Value::Collection>> collections;
+  auto shape = std::make_shared<RecordShape>();
+  std::weak_ptr<const RecordShape> weak = shape;
+  for (int i = 0; i < 4096; ++i) {
+    auto c = std::make_unique<Value::Collection>();
+    c->shape = shape;
+    c->storage.push_back(Value::text(std::string(1024, 'x')));
+    c->children.emplace_back("child", Value::integer(i));
+    c->index.emplace("child", 0);
+    collections.push_back(std::move(c));
+  }
+  shape.reset();
+  collections.clear();
+  selt::ok(weak.expired(), "released collections do not retain shape owners");
+  selt::eq(tl_collection_freelist.count, CollectionFreelist::MAX_CACHED,
+           "collection raw-storage cache is bounded");
+  auto fresh = std::make_unique<Value::Collection>();
+  selt::ok(fresh->children.empty() && fresh->index.empty() &&
+           !fresh->shape && fresh->storage.empty(), "reused collection starts empty");
+}
