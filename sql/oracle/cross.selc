### left binder reads the left relation
ORDERS .> LINK(CUSTOMERS, L, R, L["customer_id"] == R["id"]) .> MAP(RECORD("n", _["L"]["name"], "m", _["R"]["name"]))
### both binders, the shared id
ORDERS .> LINK(CUSTOMERS, L, R, L["customer_id"] == R["id"]) .> MAP(RECORD("o", _["L"]["id"], "c", _["R"]["id"]))
### left binder in a LINK_LEFT
ORDERS .> LINK_LEFT(CUSTOMERS, L, R, L["customer_id"] == R["id"]) .> MAP(RECORD("n", _["L"]["name"], "a", _["L"]["amount"]))
### sides swapped
CUSTOMERS .> LINK(ORDERS, L, R, L["id"] == R["customer_id"]) .> MAP(RECORD("n", _["L"]["name"], "i", _["R"]["id"]))
### a filter through the left binder
ORDERS .> LINK(CUSTOMERS, L, R, L["customer_id"] == R["id"]) .> FILTER(_["L"]["amount"] > 4) .> MAP(RECORD("n", _["R"]["name"]))
### a filter through the right binder
ORDERS .> LINK(CUSTOMERS, L, R, L["customer_id"] == R["id"]) .> FILTER(_["R"]["name"] $== "Ann") .> MAP(RECORD("n", _["L"]["name"]))
### relation names read their relations
ORDERS .> LINK(CUSTOMERS, _1["customer_id"] == _2["id"]) .> MAP(RECORD("n", _["ORDERS"]["name"], "m", _["CUSTOMERS"]["name"]))
### promoted fields: the shared names are neither side's
ORDERS .> LINK(CUSTOMERS, _1["customer_id"] == _2["id"]) .> MAP(RECORD("a", _["amount"], "k", _["customer_id"]))
### one relation, a filter and a projection
ORDERS .> FILTER(_["amount"] > 4) .> MAP(RECORD("n", _["name"]))
### bucket over a join
ORDERS .> LINK(CUSTOMERS, L, R, L["customer_id"] == R["id"]) .> BUCKET(_["R"]["name"], RECORD("k", _K, "n", COUNT(_)))
### _1 and _2 are keys of the joined row
ORDERS .> LINK(CUSTOMERS, _1["customer_id"] == _2["id"]) .> MAP(RECORD("n", _["_2"]["name"], "a", _["_1"]["amount"]))
### a LINK_LEFT's right side through its binder, NULL where nothing matched
ORDERS .> LINK_LEFT(CUSTOMERS, O, C, O["customer_id"] == C["id"]) .> MAP(RECORD("n", _["C"]["name"], "a", _["amount"]))
### a relation joined again under its alias
ORDERS .> LINK(CUSTOMERS, O, C, O["customer_id"] == C["id"]) .> LINK(CUSTOMERS, A, B, A["customer_id"] == B["id"]) .> MAP(RECORD("n", _["B"]["name"], "a", _["amount"]))
### refused: an alias is not a key of the row
ORDERS .> LINK(CUSTOMERS, _1["customer_id"] == _2["id"]) .> MAP(RECORD("a", _["o"]["amount"]))
### refused: a relation's name after a five-argument LINK
ORDERS .> LINK(CUSTOMERS, O, C, O["customer_id"] == C["id"]) .> MAP(RECORD("n", _["CUSTOMERS"]["name"]))
### refused: a relation's name inside a five-argument predicate
ORDERS .> LINK(CUSTOMERS, O, C, ORDERS["customer_id"] == C["id"]) .> MAP(RECORD("a", _["amount"]))
### refused: a later LINK's left binder is the joined row, which has no shared name
ORDERS .> LINK(CUSTOMERS, O, C, O["customer_id"] == C["id"]) .> LINK(CUSTOMERS, A, B, A["id"] == B["id"]) .> MAP(RECORD("a", _["amount"]))
