### entry: funcs.PADR
PADR("7", 3, "0")
PADR("7777", 2, "0")

### entry: funcs.BACKWARDS
BACKWARDS("abc")
BACKWARDS("zażółć")
BACKWARDS("")

% --- code points -------------------------------------------------------------
%
% Refused by mariadb, whose ORD and CHAR read bytes rather than code points, and
% supported by sqlite, whose unicode() and char() are what SEL means. Added
% because the coverage gate demanded them the day sqlite was written: nothing in
% the corpus reached an entry no other dialect had.

### entry: funcs.CODE
CODE("a")
CODE("é")
CODE("ż")

### entry: funcs.CHAR
CHAR(97)
CHAR(233)
CHAR(380)

% --- numbers ----------------------------------------------------------------

### entry: funcs.ABS
ABS(-5)
ABS(5)
ABS(-2.50)

### entry: funcs.SIGN
SIGN(-3)
SIGN(0)
SIGN(3)

### entry: funcs.CEIL
CEIL(2.1)
CEIL(-2.1)
CEIL(2)

### entry: funcs.FLOOR
FLOOR(2.9)
FLOOR(-2.9)
FLOOR(2)

### entry: funcs.TRUNC
TRUNC(2.9)
TRUNC(-2.9)
TRUNC(2)

### entry: funcs.ROUND
ROUND(2.5, 0)
ROUND(-2.5, 0)
ROUND(1.2345, 2)
ROUND(1.005, 2)

### entry: funcs.MIN
MIN(3, 1, 2)
MIN(1)
MIN(-1, -2)

### entry: funcs.MAX
MAX(3, 1, 2)
MAX(1)
MAX(-1, -2)

### entry: funcs.POWER
POWER(2, 10)
POWER(2, 0)
POWER(10, 3)

### entry: funcs.ISNUM
ISNUM("12.5")
ISNUM(" 2")
ISNUM("x")
ISNUM("")

% --- binary -----------------------------------------------------------------

### entry: funcs.BLEN
BLEN("zażółć")
BLEN("")
BLEN("abc")

### entry: funcs.TO_UTF8
TO_HEX(TO_UTF8("zażółć"))
TO_HEX(TO_UTF8(""))

### entry: funcs.FROM_UTF8
FROM_UTF8(TO_UTF8("zażółć"))
FROM_UTF8(FROM_HEX("616263"))

### entry: funcs.TO_HEX
TO_HEX(FROM_HEX("414243"))
TO_HEX(TO_UTF8("a"))

### entry: funcs.FROM_HEX
FROM_UTF8(FROM_HEX("414243"))
BLEN(FROM_UTF8(FROM_HEX("c3a9")))

### entry: funcs.ENCODE_BASE64
ENCODE_BASE64(TO_UTF8("hello"))
ENCODE_BASE64(TO_UTF8(""))
ENCODE_BASE64(TO_UTF8("a longer string, long enough to pass the wrap column that TO_BASE64 inserts on its own"))

### entry: funcs.DECODE_BASE64
TO_HEX(DECODE_BASE64("aGVsbG8="))
FROM_UTF8(DECODE_BASE64("aGVsbG8="))

### entry: funcs.CRC32
CRC32("hello")
CRC32("")
CRC32("zażółć")

% --- regex ------------------------------------------------------------------
%
% Every one of these disagreed with MariaDB at some point in M1: the engine is
% case-insensitive by default, its `.` does not match a newline, and its `\d`
% matches digits SEL's does not.

### entry: funcs.RMATCH
RMATCH('^[a-z]+$', "abc")
RMATCH('^[a-z]+$', "ABC")
RMATCH('^abc$', "ABC", "i")
RMATCH('^a.c$', "a\nc")
RMATCH('^\d+$', "123")
RMATCH('^\d+$', "٣")
RMATCH('^$', "")

### entry: funcs.RFIND
RFIND('ó', "zażółć")
RFIND('z', "abc")
RFIND('[0-9]+', "ab123")
RFIND('^ABC$', "abc")

% --- conditionals -----------------------------------------------------------

### entry: skel.case
IF(TRUE, "y", "n")
IF(FALSE, "y", "n")
COND(FALSE, "a", TRUE, "b", "c")
COND(FALSE, "a", FALSE, "b", "c")
IF(1 > 2, 10, 20)

% --- aggregates over static lists -------------------------------------------
%
% A static list unrolls at translation time, so these reach the operators' own
% templates and NO aggregate skeleton — which is the property that makes
% `ALL((a, b), p)` and `p(a) AND p(b)` the same bytes. The headers say `mixed`
% for that reason: there is no entry for the coverage gate to attribute them to,
% and claiming `skel.all` would be a claim the trace refuses to confirm.
%
% The skeletons themselves are reached by sql/oracle/rows.json, because a
% correlated subquery needs a query to correlate to.

### entry: mixed:static-all
ALL((1, 2, 3), _ > 0)
ALL((1, 2, 3), _ > 2)
ALL((5), _ > 0)
ALL(FILTER((1, 2, 3), _ > 1), _ > 2)

### entry: mixed:static-any
ANY((1, 2), _ > 1)
ANY((1, 2), _ > 5)
ANY(FILTER((1, 2, 3), _ > 1), _ > 2)

### entry: mixed:static-sum
SUM((1, 2, 3), _ * 2)
SUM((2.50, 2.50), _)
SUM(FILTER((1, 2, 3), _ > 1), _)

### entry: mixed:static-count
COUNT((1, 2, 3))
COUNT(FILTER((1, 2, 3), _ <= 1))
COUNT("hello")

% --- mixed ------------------------------------------------------------------
%
% Compositions, because a defect that survives every entry in isolation can still
% appear where two of them meet — an operand transformed for one operator and
% then handed to another.

### entry: mixed:compositions
UPPER("abc") $== "ABC"
LEN(UPPER("zażółć")) == 6
TRIM(" " & "x" & " ")
IF("A" $== "a", "wrong", "right")
ALL((1, 2, 3), _ * 2 > 1)
NOT ("5.00" $== "5")
(2.50 + 2.50) == 5
FIND("a", UPPER("banana"))
"x" & IF(TRUE, "y", "n")
ROUND(10 / 4, 1) == 2.5

% --- literal forms that need a binding ---------------------------------------
%
% Everything above is closed. These are not, and cannot be: a BIN literal has no
% SEL syntax, so the one literal form Emit::literal handles with its own branch
% could only be reached through a `value` binding — and until this block existed
% it had no witness anywhere. The evaluator is handed the same constants under
% the same names, so both sides are still being asked the same question.

% The hostile bytes, which the one witness above deliberately is not. 7ac3a9 is
% valid UTF-8 and contains no backslash, which is exactly the byte string that
% survived PostgreSQL's text::bytea round trip -- so for four milestones the only
% BIN in the corpus was the one that could not show the defect.

### bindings: {"B": {"kind": "value", "value": {"bin": "5c78"}}, "N": {"kind": "value", "value": {"bin": "00ff80"}}}

### entry: mixed:bin-hostile-bytes
TO_HEX(B)
BLEN(B)
TO_HEX(N)
BLEN(N)
B EQL N
ENCODE_BASE64(B)

### entry: mixed:bin-backslash-from-text
BLEN('\\')
TO_HEX('a\b')
ENCODE_BASE64('\\')
FROM_UTF8(TO_UTF8('\\'))
BLEN('\x41')
TO_HEX(TO_UTF8("é"))
FROM_UTF8(TO_UTF8("é"))

### bindings: {"B": {"kind": "value", "value": {"bin": "7ac3a9"}}}

### entry: mixed:bin-literal
TO_HEX(B)
BLEN(B)
FROM_UTF8(B)
ENCODE_BASE64(B)
B EQL B

### bindings: {"N": {"kind": "value", "value": "2.50", "type": "NUM"}, "T": {"kind": "value", "value": "2.50"}}

### entry: mixed:value-binding-forms
N + 1
N & "!"
T $== "2.50"
N $== "2.50"
T == N
BLEN(N)

### bindings: {}

% --- edges: zero, empty, long, out of range ----------------------------------
%
% Everything above asks whether a translation gives SEL's answer. This block
% asks the prior question -- whether the expression has an answer at all -- and
% it exists because for a whole milestone nothing did. LEFT("abc", -1) is not a
% SEL expression: SEL raises E_RANGE for it. It translated cleanly into all four
% dialects, and MariaDB answered '', PostgreSQL answered 'ab' and SQLite
% answered 'abc'. Three servers, three answers, none of them SEL's, from a
% translation that reported success.
%
% A `!CODE expr` line says SEL rejects the expression with that code and no
% dialect may translate it. See sql/oracle/README.md.

### entry: mixed:edge-zero
0 == -0
"0.00" $== "0"
-(0)
0 * -1
0 / 1
0 % 5
ABS(-0)
SIGN(-0.0)
CEIL(0.0)
FLOOR(-0.0)
TRUNC(-0.5)
TRUNC(0.5)
ROUND(0.00, 2)
POWER(0, 0)
POWER(0, 5)
MIN(0, -0)
0 & ""
LEN("0")
LEFT("abc", 0)
RIGHT("abc", 0)

### entry: mixed:edge-zero-divisor
!E_DIV_ZERO 1 / 0
!E_DIV_ZERO 5 % 0
!E_DIV_ZERO 0 / 0
!E_DIV_ZERO 2.50 % 0.0

### entry: mixed:edge-empty-string
LEN("")
BLEN("")
TRIM("")
LTRIM("")
RTRIM("")
REPLACE("a", "b", "")
FIND("a", "")
"" & ""
"" $== ""
"" $< "a"
SUBSTR("", 1)
SUBSTR("abc", 4)
UPPER("")
LOWER("")
TO_HEX(TO_UTF8(""))
FROM_UTF8(TO_UTF8(""))

### entry: mixed:edge-long-string
LEN(REPEAT("ab", 500))
LEN(REPEAT("z", 500))
BLEN(REPEAT("z", 300))
LEFT(REPEAT("ab", 500), 3)
RIGHT(REPEAT("ab", 500), 3)
SUBSTR(REPEAT("ab", 500), 999)
FIND("ba", REPEAT("ab", 500))
LEN(UPPER(REPEAT("ab", 400)))
LEN(BACKWARDS(REPEAT("ab", 300)))
LEN(TRIM(REPEAT(" ", 300) & "x"))

### entry: mixed:edge-argument-out-of-range
!E_RANGE LEFT("abc", -1)
!E_RANGE RIGHT("abc", -1)
!E_RANGE SUBSTR("abc", 0)
!E_RANGE SUBSTR("abc", -1)
!E_RANGE SUBSTR("abc", 1, -1)
!E_RANGE PADL("x", -1, "0")
!E_RANGE PADR("x", -1, "0")
!E_RANGE REPEAT("x", -1)
!E_RANGE FIND("a", "banana", 0)
!E_RANGE FIND("a", "banana", -1)
!E_RANGE ROUND(1.5, -1)
!E_RANGE POWER(10, -2)
!E_RANGE CHAR(-1)
!E_RANGE CHAR(1114112)
!E_RANGE CODE("")

### entry: mixed:edge-concat-two-non-text
2.50 & 2.50
1 & 2
LEN("a") & LEN("b")
ABS(-1) & 2

### entry: mixed:edge-isnum-anchor
ISNUM("12\n")
ISNUM("1.5\n")
ISNUM("12\r")
ISNUM("12")
ISNUM("1.5")
ISNUM("abc")

% Quoting, which nothing outside 01-lexical.sqlt exercised -- and every case in
% that file is `dialect mariadb`, so PostgreSQL's and SQLite's escaping had no
% witness anywhere: not in cases, not here, not in rows.json, and not in the
% fuzz generator, which never puts an apostrophe inside a text literal. Halving
% postgresql's '' escape is a live injection that survived every check.

% Lines that cross a caveat's boundary. Each caveat below was declared, reached
% by the corpus, and never actually differed -- so nothing had ever checked
% whether the claim was true, still needed, or hiding a defect.

### entry: mixed:caveat-crossings
LEN(MIN(17, 123.456))
LEN(MAX(17, 123.456))
POWER(3, 40)
POWER(2, 64)
LEN(POWER(2, 10))
LEN(POWER(10, 3))
RMATCH('^abc$', "abc\n")
RFIND('c$', "abc\n")
ROUND(-2.5, 0)
ROUND(2.675, 2)
ROUND(-0.125, 2)
99999999999999999999 != 99999999999999999998
99999999999999999999 < 99999999999999999998
99999999999999999999 <= 99999999999999999998
99999999999999999999 > 99999999999999999998
99999999999999999999 >= 99999999999999999998
0.1 + 0.2 == 0.3

### entry: mixed:edge-quoting
LEN("it's")
"it's" $== "it's"
LEN("a\\b")
"a\\b" $== "a\\b"
LEN("a\"b")
UPPER("it's")
LEN("--")
LEN("';")
"a'b" & "c'd"

### entry: mixed:edge-case-branch-scale
LEN(IF(FALSE, 2.50, 3))
LEN(IF(TRUE, 3, 2.50))
IF(FALSE, 2.50, 3) $== "3"
IF(FALSE, 2.50, 3)

### entry: mixed:edge-integer-valued-decimal
LEFT("abc", 2.0)
RIGHT("abc", 2.0)
SUBSTR("abc", 1.0)
ROUND(1.5, 1.0)
PADL("x", 3.0, "0")
LEFT("abc", -0)
LEFT("abc", 1.0 + 1.0)
LEFT("abc", "2")

### entry: mixed:edge-argument-not-an-integer
!E_NOT_INT LEFT("abc", 2.7)
!E_NOT_INT SUBSTR("abc", 1.5)
!E_NOT_INT REPEAT("x", 2.5)
!E_NOT_INT ROUND(1.234, 1.5)
!E_NOT_INT PADL("x", 3.5, "0")
!E_NOT_INT RIGHT("abc", 0.5)

### entry: mixed:edge-argument-not-a-number
!E_NOT_NUM LEFT("abc", " 2")
!E_NOT_NUM SUBSTR("abc", "1 ")
!E_NOT_NUM REPEAT("x", "")
!E_BAD_ARG FIND("", "abc")
!E_BAD_ARG PADL("x", 3, "")
!E_BAD_ARG PADR("x", 3, "")

### entry: mixed:edge-large-magnitude
99999999999999999999999999999999999999 + 1
99999999999999999999999999999999999999 * 2
-99999999999999999999999999999999 - 1
ABS(-99999999999999999999999999999999999999)
POWER(10, 40)
99999999999999999999 == 99999999999999999998
99999999999999999999999999999999999999 == 99999999999999999999999999999999999998

### entry: mixed:edge-small-magnitude
0.00000000000000000000000000000001
0.00000000000000000000000000000001 + 0
0.00000000000000000000000000000001 * 2
0.000000000000000000000000000000000000001 * 2
0.00000000000000000000000000000001 == 0.00000000000000000000000000000002

% --- a value binding is a constant the translator has -----------------------
%
% §5.4 calls it "a constant supplied at translation time, inlined as a literal".
% So these are exactly as knowable as the literal forms above, and until the
% constant check learned about bindings they were exactly as wrong: SEL raised
% and the servers answered ''/''/'ab'/''. The last two lines are the other half
% -- a value binding that is fine must still translate.

### bindings: {"X": {"kind": "value", "value": "-1", "type": "NUM"}, "Z": {"kind": "value", "value": "0", "type": "NUM"}, "S": {"kind": "value", "value": "abc"}}

### entry: mixed:edge-value-binding-is-constant
!E_RANGE LEFT("abc", X)
!E_RANGE SUBSTR("abc", X)
!E_RANGE REPEAT("x", X)
!E_DIV_ZERO 1 / Z
!E_DIV_ZERO 5 % Z
!E_NOT_NUM S + 1
S & "!"
LEN(S)

### bindings: {}

% --- a number in a text position, and text in a numeric one -------------------
%
% SEL numbers ARE text (spec §4), so every one of these is ordinary SEL and each
% one hands a template an operand of the "wrong" SQL type. MySQL coerces
% silently, which is why the ansi templates these inherit from looked correct
% for years; a conformant server does not, and `ansi-probe` is where that shows.

### entry: mixed:numbers-are-text
LEN(2.50)
UPPER(2.50)
LOWER(2.50)
TRIM(2.50)
SUBSTR(12345, 2, 2)
2.50 & "x"
LEN(1 + 1)

### entry: mixed:text-is-numbers
ABS("-5")
CEIL("2.5")
FLOOR("2.5")
POWER("2", "3")
"5" + 1
"10" / "4"

### entry: mixed:arithmetic-over-two-text-operands
"5" + "1"
"5" - "1"
"5" * "2"
"5" % "2"
-"5"
