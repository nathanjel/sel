LEFT("banana", 3)
LEFT("zażółć", 3)
LEFT("ab", 10)
LEFT("ab", 0)

### entry: funcs.RIGHT
RIGHT("banana", 3)
RIGHT("zażółć", 3)
RIGHT("ab", 10)

### entry: funcs.SUBSTR
SUBSTR("banana", 2)
SUBSTR("banana", 2, 3)
SUBSTR("zażółć", 3, 2)
SUBSTR("ab", 5)

### entry: funcs.FIND
FIND("a", "banana")
FIND("a", "banana", 3)
FIND("z", "banana")
FIND("ó", "zażółć")
FIND("na", "banana")

### entry: funcs.REPLACE
REPLACE("a", "o", "banana")
REPLACE("x", "y", "banana")
REPLACE("ż", "z", "zażółć")

### entry: funcs.TRIM
TRIM("  x  ")
TRIM("x")
TRIM("\t\r\n x \n")

### entry: funcs.LTRIM
LTRIM("  x")
LTRIM("x  ")

### entry: funcs.RTRIM
RTRIM("x  ")
RTRIM("  x")

### entry: funcs.REPEAT
REPEAT("ab", 3)
REPEAT("ab", 0)
REPEAT("ż", 2)

### entry: funcs.PADL
PADL("7", 3, "0")
PADL("7777", 2, "0")
