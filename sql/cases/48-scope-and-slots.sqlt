### name: bucket.sum.numeric-literal
--- note
The body of SUM inside a BUCKET projection keeps its literals. Derived from the WHERE-clause rendering of the same body.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "alias": "i", "fields": {"DEPT": {"kind": "column", "table": "i", "column": "dept", "type": "TEXT"}, "QTY": {"kind": "column", "table": "i", "column": "qty", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["DEPT"], RECORD("k", _K, "s", SUM(_, _["QTY"] * 2)))
--- expect
SELECT CAST(`i`.`dept` AS CHAR) COLLATE utf8mb4_nopad_bin AS `k`, COALESCE(SUM((`i`.`qty` * 2)), 0) AS `s` FROM `items` `i` GROUP BY CAST(`i`.`dept` AS CHAR) COLLATE utf8mb4_nopad_bin
===

### name: bucket.sum.two-numeric-literals
--- note
The body of SUM inside a BUCKET projection keeps its literals. Derived from the WHERE-clause rendering of the same body.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "alias": "i", "fields": {"DEPT": {"kind": "column", "table": "i", "column": "dept", "type": "TEXT"}, "QTY": {"kind": "column", "table": "i", "column": "qty", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["DEPT"], RECORD("k", _K, "s", SUM(_, _["QTY"] * 7 + 5)))
--- expect
SELECT CAST(`i`.`dept` AS CHAR) COLLATE utf8mb4_nopad_bin AS `k`, COALESCE(SUM(((`i`.`qty` * 7) + 5)), 0) AS `s` FROM `items` `i` GROUP BY CAST(`i`.`dept` AS CHAR) COLLATE utf8mb4_nopad_bin
===

### name: bucket.sum.text-literal-in-if
--- note
The body of SUM inside a BUCKET projection keeps its literals. Derived from the WHERE-clause rendering of the same body.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "alias": "i", "fields": {"DEPT": {"kind": "column", "table": "i", "column": "dept", "type": "TEXT"}, "QTY": {"kind": "column", "table": "i", "column": "qty", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["DEPT"], RECORD("k", _K, "s", SUM(_, IF(_["DEPT"] $== "x", 1, 2))))
--- expect
SELECT CAST(`i`.`dept` AS CHAR) COLLATE utf8mb4_nopad_bin AS `k`, COALESCE(SUM(CASE WHEN (CAST(`i`.`dept` AS CHAR) COLLATE utf8mb4_nopad_bin = CAST('x' AS CHAR) COLLATE utf8mb4_nopad_bin) THEN 1 ELSE 2 END), 0) AS `s` FROM `items` `i` GROUP BY CAST(`i`.`dept` AS CHAR) COLLATE utf8mb4_nopad_bin
===

### name: bucket.sum.text-literal-in-if-params
--- note
The body of SUM inside a BUCKET projection keeps its literals. Derived from the WHERE-clause rendering of the same body.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "alias": "i", "fields": {"DEPT": {"kind": "column", "table": "i", "column": "dept", "type": "TEXT"}, "QTY": {"kind": "column", "table": "i", "column": "qty", "type": "NUM"}}}}
--- mode
params
--- as
statement
--- source
ITEMS .> BUCKET(_["DEPT"], RECORD("k", _K, "s", SUM(_, IF(_["DEPT"] $== "x", 1, 2))))
--- expect
SELECT CAST(`i`.`dept` AS CHAR) COLLATE utf8mb4_nopad_bin AS `k`, COALESCE(SUM(CASE WHEN (CAST(`i`.`dept` AS CHAR) COLLATE utf8mb4_nopad_bin = CAST(? AS CHAR) COLLATE utf8mb4_nopad_bin) THEN 1 ELSE 2 END), 0) AS `s` FROM `items` `i` GROUP BY CAST(`i`.`dept` AS CHAR) COLLATE utf8mb4_nopad_bin
--- params
t"x"
===

### name: bucket.sum.nested-if-two-text-slots
--- note
The body of SUM inside a BUCKET projection keeps its literals. Derived from the WHERE-clause rendering of the same body.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "alias": "i", "fields": {"DEPT": {"kind": "column", "table": "i", "column": "dept", "type": "TEXT"}, "QTY": {"kind": "column", "table": "i", "column": "qty", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["DEPT"], RECORD("k", _K, "s", SUM(_, IF(_["DEPT"] $== "x", IF(_["DEPT"] $== "y", 3, 4), 5))))
--- expect
SELECT CAST(`i`.`dept` AS CHAR) COLLATE utf8mb4_nopad_bin AS `k`, COALESCE(SUM(CASE WHEN (CAST(`i`.`dept` AS CHAR) COLLATE utf8mb4_nopad_bin = CAST('x' AS CHAR) COLLATE utf8mb4_nopad_bin) THEN CASE WHEN (CAST(`i`.`dept` AS CHAR) COLLATE utf8mb4_nopad_bin = CAST('y' AS CHAR) COLLATE utf8mb4_nopad_bin) THEN 3 ELSE 4 END ELSE 5 END), 0) AS `s` FROM `items` `i` GROUP BY CAST(`i`.`dept` AS CHAR) COLLATE utf8mb4_nopad_bin
===

