ITEMS .> BUCKET(_["DEPT"], RECORD("k", _K, "s", SUM(_, IF(_["DEPT"] $== "x", IF(_["DEPT"] $== "y", 3, 4), 5))))
--- expect
SELECT CAST(`i`.`dept` AS CHAR) COLLATE utf8mb4_nopad_bin AS `k`, COALESCE(SUM(CASE WHEN (CAST(`i`.`dept` AS CHAR) COLLATE utf8mb4_nopad_bin = CAST(? AS CHAR) COLLATE utf8mb4_nopad_bin) THEN CASE WHEN (CAST(`i`.`dept` AS CHAR) COLLATE utf8mb4_nopad_bin = CAST(? AS CHAR) COLLATE utf8mb4_nopad_bin) THEN 3 ELSE 4 END ELSE 5 END), 0) AS `s` FROM `items` `i` GROUP BY CAST(`i`.`dept` AS CHAR) COLLATE utf8mb4_nopad_bin
