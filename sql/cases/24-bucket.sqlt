# Statements: BUCKET and HAVING in relational pipelines.
#
# Covers BUCKET key forms (single, LIST, RECORD),
# aggregate projections (COUNT(*), SUM with COALESCE),
# pre-filtering (WHERE) vs post-filtering (HAVING),
# sorting by aggregate aliases in ORDER BY,
# pagination with BUCKET, and dialect parity.

### name: stmt.bucket.basic
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"])
--- expect
SELECT CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin FROM `items` GROUP BY CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin
===

### name: stmt.bucket.multi-list
--- note
Grouping by several keys is the projected spelling's: it groups by identity
(spec §3.4) and needs no map key. A bare bucket over a list key is refused
(refuse-bare-bucket-over-a-list-key) -- it used to render as this statement
while the evaluator collapsed every group onto one entry.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "CATEGORY": {"kind": "column", "column": "category", "type": "TEXT"}}}}
--- as
statement
--- source
ITEMS .> BUCKET((_["dept"], _["category"]), RECORD("n", COUNT(_)))
--- expect
SELECT COUNT(*) AS `n` FROM `items` GROUP BY CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin, CAST(`category` AS CHAR) COLLATE utf8mb4_nopad_bin
===

### name: stmt.bucket.multi-record
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "CATEGORY": {"kind": "column", "column": "category", "type": "TEXT"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(RECORD("dept", _["dept"], "category", _["category"]), RECORD("n", COUNT(_)))
--- expect
SELECT COUNT(*) AS `n` FROM `items` GROUP BY CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin, CAST(`category` AS CHAR) COLLATE utf8mb4_nopad_bin
===

### name: stmt.bucket.aggregates
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"], RECORD("dept", _K, "cnt", COUNT(_), "total", SUM(_, _["amount"])))
--- expect
SELECT CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin AS `dept`, COUNT(*) AS `cnt`, COALESCE(SUM(`amount`), 0) AS `total` FROM `items` GROUP BY CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin
===

### name: stmt.bucket.custom-binder
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(r, r["dept"], RECORD("dept", _K, "total", SUM(r, x, x["amount"])))
--- expect
SELECT CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin AS `dept`, COALESCE(SUM(`amount`), 0) AS `total` FROM `items` GROUP BY CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin
===

### name: stmt.bucket.where-and-having
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}, "ACTIVE": {"kind": "column", "column": "active", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> FILTER(_["active"] == 1) .> BUCKET(_["dept"], RECORD("dept", _K, "total", SUM(_, _["amount"]))) .> FILTER(_["total"] > 100)
--- expect
SELECT CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin AS `dept`, COALESCE(SUM(`amount`), 0) AS `total` FROM `items` WHERE (`active` = 1) GROUP BY CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin HAVING (COALESCE(SUM(`amount`), 0) > 100)
===

### name: stmt.bucket.order-by-agg
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"], RECORD("dept", _K, "total", SUM(_, _["amount"]))) .> SORT_BY(_["total"], "DESC")
--- expect
SELECT CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin AS `dept`, COALESCE(SUM(`amount`), 0) AS `total` FROM `items` GROUP BY CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin ORDER BY COALESCE(SUM(`amount`), 0) DESC
===

### name: stmt.bucket.pagination
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> TAKE(10) .> DROP(5)
--- expect
SELECT CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin FROM `items` GROUP BY CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin LIMIT 5 OFFSET 5
===

### name: stmt.bucket.dialect-postgres
--- dialect
postgresql
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}, "ACTIVE": {"kind": "column", "column": "active", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> FILTER(_["active"] == 1) .> BUCKET(_["dept"], RECORD("dept", _K, "total", SUM(_, _["amount"]))) .> FILTER(_["total"] > 100) .> SORT_BY(_["total"], "DESC")
--- expect
SELECT CAST("dept" AS TEXT) COLLATE "C" AS "dept", COALESCE(SUM("amount"), 0) AS "total" FROM "items" WHERE ("active" = 1) GROUP BY CAST("dept" AS TEXT) COLLATE "C" HAVING (COALESCE(SUM("amount"), 0) > 100) ORDER BY COALESCE(SUM("amount"), 0) DESC
===

### name: stmt.bucket.dialect-sqlite
--- dialect
sqlite
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"], RECORD("dept", _K, "cnt", COUNT(_))) .> DROP(5)
--- expect
SELECT CAST("dept" AS TEXT) COLLATE BINARY AS "dept", COUNT(*) AS "cnt" FROM "items" GROUP BY CAST("dept" AS TEXT) COLLATE BINARY LIMIT -1 OFFSET 5
===

### name: stmt.bucket.dialect-mysql
--- dialect
mysql
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"], RECORD("dept", _K, "total", SUM(_, _["amount"]))) .> DROP(5)
--- expect
SELECT CAST(`dept` AS CHAR) COLLATE utf8mb4_0900_bin AS `dept`, COALESCE(SUM(`amount`), 0) AS `total` FROM `items` GROUP BY CAST(`dept` AS CHAR) COLLATE utf8mb4_0900_bin LIMIT 18446744073709551615 OFFSET 5
===

### name: stmt.bucket.refusal-binder
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(123, _["dept"], _["dept"])
--- error
E_SQL_SHAPE 1:17
===

### name: stmt.bucket.refusal-having-bool
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> FILTER("not a bool")
--- error
E_SQL_SHAPE 1:31
===

### name: stmt.bucket.refusal-unknown-field
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["unknown_col"])
--- error
E_SQL_BINDING 1:18
===

### name: stmt.bucket.pipeline-map-is-the-projection
--- note
BUCKET(src, key) .> MAP(proj) and BUCKET(src, key, proj) are one value in the
evaluator -- the MAP's body runs once per group with _ the group and _K its
key -- so they are one statement here. Before this the bare bucket was
rendered as its keys and the MAP was laid over that as a derived table, which
counted one row per group and, worse, was accepted for a body SEL refuses.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> MAP(RECORD("dept", _K, "cnt", COUNT(_)))
--- expect
SELECT CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin AS `dept`, COUNT(*) AS `cnt` FROM `items` GROUP BY CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin
===

### name: stmt.bucket.pipeline-filter-then-map
--- note
A FILTER between the bucket and its MAP is a HAVING: it sees the group, and
the MAP still closes the bucket.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> FILTER(COUNT(_) > 1) .> MAP(RECORD("dept", _K, "total", SUM(_, _["amount"])))
--- expect
SELECT CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin AS `dept`, COALESCE(SUM(`amount`), 0) AS `total` FROM `items` GROUP BY CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin HAVING (COUNT(*) > 1)
===

### name: stmt.bucket.pipeline-map-names-the-group
--- note
The MAP may name the group; _K is still the key, written against the key's
own binder.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> MAP(g, RECORD("dept", _K, "total", SUM(g, x, x["amount"])))
--- expect
SELECT CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin AS `dept`, COALESCE(SUM(`amount`), 0) AS `total` FROM `items` GROUP BY CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin
===

### name: stmt.bucket.refuse-map-after-the-members-are-spent
--- note
Once anything but a FILTER follows a bare bucket, SQL has only the keys left;
a MAP after that would run over rows SEL calls groups, so it is refused
rather than translated into a different program.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> TAKE(2) .> MAP(RECORD("dept", _K))
--- error
E_SQL_SHAPE 1:42
===
### name: stmt.bucket.refuse-bucket-over-an-open-bucket
--- note
Review 2026-09-15 finding AI. A second BUCKET over a bare bucket used to
discard the plan's bucket state and group the key rows again -- `GROUP BY
COUNT(*)`, which the database rejects, or a re-grouping of keys SEL calls
groups. Either way a different program; refused at the second BUCKET.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> BUCKET(COUNT(_)) .> MAP(RECORD("size", _K, "n", COUNT(_)))
--- error
E_SQL_SHAPE 1:31
===
### name: stmt.bucket.refuse-projected-bucket-over-an-open-bucket
--- note
The three-argument spelling is the same second bucket.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> BUCKET(COUNT(_), RECORD("size", _K, "n", COUNT(_)))
--- error
E_SQL_SHAPE 1:31
===
### name: stmt.bucket.refuse-bucket-over-a-sealed-bucket
--- note
And once the members are spent (a TAKE followed the bare bucket) a BUCKET is
refused like the MAP in refuse-map-after-the-members-are-spent.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> TAKE(2) .> BUCKET(_["dept"])
--- error
E_SQL_SHAPE 1:42
===
### name: stmt.bucket.bucket-over-a-projected-bucket
--- note
A bucket whose projection closed it is a list of records again. Computed
projection types are not carried across the derived table yet, so this second
BUCKET is refused until its key's identity can be proved. A hybrid plan can
retain the first grouped statement and perform the second grouping locally.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> MAP(RECORD("dept", _K, "n", COUNT(_))) .> BUCKET(_["n"]) .> MAP(RECORD("n", _K, "depts", COUNT(_)))
--- error
E_SQL_SHAPE
===
### name: stmt.bucket.refuse-bare-bucket-over-a-list-key
--- note
Review 2026-09-15 finding G. A bare bucket's key is an index key (spec
§7.4): one text or number, verbatim; the evaluator refuses a list or record
key with E_NOT_TEXT rather than collapse it. Multi-column grouping is the
projected spelling's, so a bare BUCKET over LIST(...) is refused at the key
instead of rendered as `GROUP BY dept, category`.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "CATEGORY": {"kind": "column", "column": "category", "type": "TEXT"}, "ACTIVE": {"kind": "column", "column": "active", "type": "BOOL"}, "QTY": {"kind": "column", "column": "qty", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(LIST(_["dept"], _["category"]))
--- error
E_SQL_SHAPE 1:17
===
### name: stmt.bucket.refuse-bare-bucket-over-a-record-key
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "CATEGORY": {"kind": "column", "column": "category", "type": "TEXT"}, "ACTIVE": {"kind": "column", "column": "active", "type": "BOOL"}, "QTY": {"kind": "column", "column": "qty", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(RECORD("d", _["dept"])) .> MAP(RECORD("n", COUNT(_)))
--- error
E_SQL_SHAPE 1:17
===
### name: stmt.bucket.refuse-bare-bucket-over-a-bool-key
--- note
The kinds an index key cannot be: a boolean or binary key is E_NOT_TEXT in
the evaluator, so the SQL must not group by it -- with or without the MAP
that closes the bucket.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "CATEGORY": {"kind": "column", "column": "category", "type": "TEXT"}, "ACTIVE": {"kind": "column", "column": "active", "type": "BOOL"}, "QTY": {"kind": "column", "column": "qty", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["active"]) .> MAP(RECORD("a", _K, "n", COUNT(_)))
--- error
E_SQL_SHAPE 1:18
===
### name: stmt.bucket.projected-spelling-takes-a-bool-key
--- note
The projected spelling groups by identity and takes any key.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "CATEGORY": {"kind": "column", "column": "category", "type": "TEXT"}, "ACTIVE": {"kind": "column", "column": "active", "type": "BOOL"}, "QTY": {"kind": "column", "column": "qty", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["active"], RECORD("a", _K, "n", COUNT(_)))
--- expect
SELECT `active` AS `a`, COUNT(*) AS `n` FROM `items` GROUP BY `active`
===
### name: stmt.bucket.filter-after-pagination
--- note
Review 2026-09-15 finding H. SEL applies the TAKE before the FILTER, so the
FILTER is a WHERE over the paginated groups, not a HAVING that runs before
the LIMIT. Four hosts appended a HAVING; the fifth wrapped. A LIMIT or
OFFSET already on the plan always forces the derived table.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "CATEGORY": {"kind": "column", "column": "category", "type": "TEXT"}, "ACTIVE": {"kind": "column", "column": "active", "type": "BOOL"}, "QTY": {"kind": "column", "column": "qty", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"], RECORD("dept", _K, "n", COUNT(_))) .> TAKE(2) .> FILTER(_["n"] > 1)
--- expect
SELECT `_sub1`.* FROM (SELECT CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin AS `dept`, COUNT(*) AS `n` FROM `items` GROUP BY CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin LIMIT 2) `_sub1` WHERE (CASE WHEN (`_sub1`.`n` REGEXP '\\A-?[0-9]+(\\.[0-9]+)?\\z') THEN CAST(`_sub1`.`n` AS DECIMAL(65,10)) ELSE NULL END > 1)
===
### name: stmt.bucket.filter-after-drop
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "CATEGORY": {"kind": "column", "column": "category", "type": "TEXT"}, "ACTIVE": {"kind": "column", "column": "active", "type": "BOOL"}, "QTY": {"kind": "column", "column": "qty", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"], RECORD("dept", _K, "n", COUNT(_))) .> DROP(1) .> FILTER(_["n"] > 1)
--- expect
SELECT `_sub1`.* FROM (SELECT CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin AS `dept`, COUNT(*) AS `n` FROM `items` GROUP BY CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin LIMIT 18446744073709551615 OFFSET 1) `_sub1` WHERE (CASE WHEN (`_sub1`.`n` REGEXP '\\A-?[0-9]+(\\.[0-9]+)?\\z') THEN CAST(`_sub1`.`n` AS DECIMAL(65,10)) ELSE NULL END > 1)
===
### name: stmt.bucket.filter-after-sort
--- note
An ORDER BY before the FILTER is different: a HAVING then an ORDER BY is the
same rows in the same order as sorting then filtering, so no wrap.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "CATEGORY": {"kind": "column", "column": "category", "type": "TEXT"}, "ACTIVE": {"kind": "column", "column": "active", "type": "BOOL"}, "QTY": {"kind": "column", "column": "qty", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"], RECORD("dept", _K, "s", SUM(_, _["qty"]))) .> SORT_BY(_["s"], "DESC") .> FILTER(_["s"] > 5)
--- expect
SELECT CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin AS `dept`, COALESCE(SUM(`qty`), 0) AS `s` FROM `items` GROUP BY CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin HAVING (COALESCE(SUM(`qty`), 0) > 5) ORDER BY COALESCE(SUM(`qty`), 0) DESC
===
### name: stmt.bucket.refuse-filter-after-the-members-are-spent
--- note
A bare bucket paginated and then filtered: SQL has only the keys left, and
a FILTER over them (`COUNT(_) > 1`) would ask about members that are gone.
Refused like the MAP in refuse-map-after-the-members-are-spent.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "CATEGORY": {"kind": "column", "column": "category", "type": "TEXT"}, "ACTIVE": {"kind": "column", "column": "active", "type": "BOOL"}, "QTY": {"kind": "column", "column": "qty", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> TAKE(2) .> FILTER(COUNT(_) > 1)
--- error
E_SQL_SHAPE 1:42
===
### name: stmt.bucket.text-key-is-collated
--- note
Review 2026-09-15 finding L. The evaluator groups by the key's exact bytes;
a server's default collation would not (MariaDB's utf8mb4_uca1400_ai_ci
merged 'A' and 'a' into one group where run() answers two). A TEXT key is
therefore cast and collated exactly as the `$` family compares text, and the
projected key is the identical expression -- MySQL's only_full_group_by
accepts nothing else. utf8mb4_bin is PAD SPACE on MariaDB and MySQL, so 'A'
and 'A ' still merge; that is the text-collation caveat, not this case.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "QTY": {"kind": "column", "column": "qty", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> MAP(RECORD("dept", _K, "n", COUNT(_)))
--- expect
SELECT CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin AS `dept`, COUNT(*) AS `n` FROM `items` GROUP BY CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin
===
### name: stmt.bucket.text-key-compared-in-having-is-the-same-expression
--- note
`_K` renders as the group key wherever it appears, and the key is already
collated, so a `$==` over it does not wrap it a second time. In a HAVING it
is wrapped in MIN(): MariaDB and MySQL resolve a HAVING column only against
the GROUP BY columns and the select list, and once the grouping is the
collated expression the bare column is "unknown column in HAVING" (the
statement oracle found it); the key is constant within its group, so MIN of
it is the key, and an aggregate is what every server lets a HAVING name.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "QTY": {"kind": "column", "column": "qty", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> FILTER(_K $== "x") .> MAP(RECORD("dept", _K, "n", COUNT(_)))
--- expect
SELECT CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin AS `dept`, COUNT(*) AS `n` FROM `items` GROUP BY CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin HAVING (MIN(CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin) = 'x')
===
### name: stmt.bucket.exact-text-key-stays-bare
--- note
A column the binding declares `exact` is already binary-collated, and is
grouped as it is compared: bare.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT", "exact": true}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> MAP(RECORD("dept", _K, "n", COUNT(_)))
--- expect
SELECT `dept` AS `dept`, COUNT(*) AS `n` FROM `items` GROUP BY `dept`
===
### name: stmt.bucket.numeric-key-preserves-representation
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "QTY": {"kind": "column", "column": "qty", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["qty"]) .> MAP(RECORD("qty", _K, "n", COUNT(_)))
--- expect
SELECT MIN(`qty`) AS `qty`, COUNT(*) AS `n` FROM `items` GROUP BY CAST(`qty` AS CHAR) COLLATE utf8mb4_nopad_bin
===
### name: stmt.bucket.text-sort-key-is-collated
--- note
The same for a sort key: SEL orders text by its bytes, and a server's
default collation orders A, a, B where SEL orders A, B, a.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "QTY": {"kind": "column", "column": "qty", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> SORT_BY(_["dept"], "DESC") .> TAKE(3)
--- expect
SELECT * FROM `items` ORDER BY CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin DESC LIMIT 3
===
### name: stmt.map.after-sort-shares-the-statement
--- note
A MAP after a SORT_BY does not wrap the sorted rows in a derived table: the
projection and the ORDER BY share one statement, because MariaDB drops an
ORDER BY inside a derived table that has no LIMIT -- the statement oracle's
sorted rows came back in table order. With a LIMIT the wrap stays (the
LIMIT keeps the order, and it must apply before the projection's aliases).
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "QTY": {"kind": "column", "column": "qty", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> SORT_BY(_["dept"]) .> MAP(RECORD("d", _["dept"], "q", _["qty"]))
--- expect
SELECT `dept` AS `d`, `qty` AS `q` FROM `items` ORDER BY CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin ASC
===
### name: stmt.bucket.refuse-member-field-through-the-group
--- note
Review 2026-09-15 finding J. Inside the projection the group binder is the
list of the bucket's members, and indexing a list by a field name is
E_NO_KEY in SEL (at the index, 1:65). The translator rendered `amount` as a
bare column under GROUP BY -- one member's value, chosen by the server --
so it now refuses at the same node. The members are read through an
aggregate: SUM(g, _["amount"]), COUNT(g).
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> MAP(g, RECORD("dept", _K, "amt", g["amount"]))
--- error
E_SQL_SHAPE 1:65
===
### name: stmt.bucket.refuse-member-field-in-the-three-argument-spelling
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"], RECORD("dept", _K, "amt", _["amount"]))
--- error
E_SQL_SHAPE 1:55
===
### name: stmt.bucket.refuse-the-bare-group-as-a-value
--- note
The group itself is a list of records, which no SQL value is.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> MAP(RECORD("d", _K, "m", _))
--- error
E_SQL_SHAPE 1:56
===
### name: stmt.bucket.refuse-a-member-by-position
--- note
`_["1"]` is the first member -- a value SEL has and SQL, whose groups are
unordered, does not.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> MAP(RECORD("d", _K, "first", _["1"]["amount"]))
--- error
E_SQL_SHAPE 1:61
===
### name: stmt.bucket.refuse-having-alias-before-the-map
--- note
A FILTER between a bare BUCKET and its MAP runs over the groups, before the
MAP has made a "total": `_["total"]` there is E_NO_KEY in SEL (1:39). The
translator resolved it through the alias the later MAP defines and rendered
the aggregate in the HAVING.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> FILTER(_["total"] > 1) .> MAP(RECORD("dept", _K, "total", SUM(_, _["amount"])))
--- error
E_SQL_SHAPE 1:39
===
### name: stmt.bucket.refuse-member-field-in-a-having-over-the-groups
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> FILTER(_["dept"] $== "A") .> MAP(RECORD("d", _K))
--- error
E_SQL_SHAPE 1:39
===
### name: stmt.bucket.refuse-max-over-the-group
--- note
MIN and MAX are variadic scalars in SEL (docs/LANGUAGE.md); `MAX(_, body)`
over a group is not a form SEL has -- it indexes the list and raises -- and
the per-group MIN/MAX/AVG arm that rendered it as `MAX(amount)` is gone.
The refusal is at the group binder, the first thing the scalar MAX cannot
take.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"], RECORD("dept", _K, "mx", MAX(_, _["amount"])))
--- error
E_SQL_SHAPE 1:57
===
### name: stmt.bucket.two-argument-sum-binds-the-member
--- note
`SUM(g, body)` binds `_` to each member for the body, as the evaluator does
(spec §7.3), whatever the group is called. Four hosts refused this as an
unbound `_` while accepting only the three-argument `SUM(g, x, x["amount"])`.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> MAP(g, RECORD("dept", _K, "n", COUNT(g), "s", SUM(g, _["amount"]), "t", SUM(g, x, x["amount"])))
--- expect
SELECT CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin AS `dept`, COUNT(*) AS `n`, COALESCE(SUM(`amount`), 0) AS `s`, COALESCE(SUM(`amount`), 0) AS `t` FROM `items` GROUP BY CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin
===
### name: stmt.bucket.refuse-the-member-key-inside-the-aggregate
--- note
Inside SUM's body `_K` is the member's position within its group, "1",
"2", ... -- not the group key, and not anything SQL has.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> MAP(RECORD("d", _K, "s", SUM(_, _K)))
--- error
E_SQL_SHAPE 1:63
===
### name: stmt.bucket.refuse-count-of-the-group-under-another-name
--- note
Naming the group `g` leaves `_` unbound in the projection, as in the
evaluator (E_UNDEF_VAR at the `_`); COUNT(_) there is not COUNT(*).
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> MAP(g, RECORD("d", _K, "n", COUNT(_)))
--- error
E_SQL_UNBOUND 1:65
===
### name: stmt.bucket.refuse-source-key-before-the-bucket
--- note
Review 2026-09-15 finding K. Before the BUCKET, `_K` is the source row's
key -- its position in the list -- which a relation's rows do not have
(sql/errors.md: E_SQL_SHAPE). Every host bound `_K` to the group key
wherever the statement had one, and rendered this as `WHERE dept = '2'`.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> FILTER(_K $== "2") .> BUCKET(_["dept"], RECORD("k", _K, "n", COUNT(_)))
--- error
E_SQL_SHAPE 1:17
===
### name: stmt.bucket.refuse-list-key-after-the-projection
--- note
After the projection the rows are a list renumbered from "1", so `_K` is
"1", "2", ... -- the position, again, not the group key (conformance
rel.bucket.map-of-key-then-sort-by-key). Rendered as `HAVING dept = '2'`
before this.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> MAP(RECORD("k", _K, "n", COUNT(_))) .> FILTER(_K $== "2")
--- error
E_SQL_SHAPE 1:77
===
### name: stmt.bucket.refuse-list-key-in-a-sort-after-the-projection
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"], RECORD("k", _K, "n", COUNT(_))) .> SORT_BY(_K)
--- error
E_SQL_SHAPE 1:71
===
### name: stmt.bucket.refuse-source-key-as-the-bucket-key
--- note
`BUCKET(_K)` groups the source rows by their own keys, which a relation's
rows do not have. It used to recurse until E_SQL_DEPTH.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_K)
--- error
E_SQL_SHAPE 1:17
===
### name: stmt.bucket.group-key-sorts-the-bare-bucket
--- note
Where `_K` IS the group key: a sort over the bare bucket's groups, and a
FILTER between the bucket and its MAP (stmt.bucket.text-key-compared-in-having-is-the-same-expression).
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> SORT_BY(_K, "DESC")
--- expect
SELECT CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin FROM `items` GROUP BY CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin ORDER BY MIN(CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin) DESC
===
### name: stmt.bucket.refuse-member-field-in-a-sort-over-the-groups
--- note
Sorting the bare bucket's groups by a member field indexes the member list:
E_NO_KEY in SEL.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> SORT_BY(_["dept"])
--- error
E_SQL_SHAPE 1:40
===
### name: stmt.bucket.projected-row-has-only-the-projection
--- note
After the projection a row is the record the MAP built, so a FILTER or a
sort over it may name the projection's fields and nothing else: `dept` is
not one of them here (E_NO_KEY in SEL), however much the source has it.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> MAP(RECORD("d", _K, "n", COUNT(_))) .> SORT_BY(_["dept"])
--- error
E_SQL_SHAPE 1:79
===
### name: stmt.bucket.projected-key-alias-in-a-having
--- note
And when the projection does carry the key, under any name, a FILTER after
it reads the projection: the key, rendered as it is in the GROUP BY and, in
a HAVING, as MIN of it, which is what MariaDB and MySQL resolve.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> MAP(RECORD("d", _K, "n", COUNT(_))) .> FILTER(_["d"] $== "A")
--- expect
SELECT CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin AS `d`, COUNT(*) AS `n` FROM `items` GROUP BY CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin HAVING (MIN(CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin) = 'A')
===
### name: stmt.bucket.projected-key-alias-in-a-sort
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> MAP(RECORD("d", _K, "n", COUNT(_))) .> SORT_BY(_["d"], "DESC")
--- expect
SELECT CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin AS `d`, COUNT(*) AS `n` FROM `items` GROUP BY CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin ORDER BY MIN(CAST(`dept` AS CHAR) COLLATE utf8mb4_nopad_bin) DESC
===
### name: stmt.bucket.refuse-count-of-the-projected-row
--- note
After the projection `_` is the projected record and COUNT of it is its
number of fields -- 1 here -- not the group's size: not COUNT(*), which is
what every host rendered.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> MAP(RECORD("d", _K)) .> FILTER(COUNT(_) > 0)
--- error
E_SQL_SHAPE 1:68
===
### name: stmt.bucket.refuse-all-over-the-groups
--- note
Only COUNT and SUM are rendered over a bucket's members; ALL and ANY would
need a correlated subquery this layer does not build.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> FILTER(ALL(_, _["amount"] > 5)) .> MAP(RECORD("d", _K))
--- error
E_SQL_SHAPE 1:42
===
### name: stmt.bucket.refuse-count-of-a-bucket-in-the-projection
--- note
Finding X, second facet, inside a projection: `COUNT(BUCKET(_, key))` is
the number of distinct statuses in the group, which SQL could spell as
COUNT(DISTINCT status) but this layer does not; it rendered the literal 0.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "STATUS": {"kind": "column", "column": "status", "type": "TEXT"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> MAP(RECORD("d", _K, "by_status", COUNT(BUCKET(_, _["status"]))))
--- error
E_SQL_SHAPE 1:70
===
