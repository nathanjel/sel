# Statements: BUCKET and HAVING in relational pipelines.
#
# Covers BUCKET key forms (single, LIST, RECORD),
# aggregate projections (COUNT(*), SUM with COALESCE),
# pre-filtering (WHERE) vs post-filtering (HAVING),
# sorting by aggregate aliases in ORDER BY,
# pagination with BUCKET, and dialect parity.

### name: stmt.bucket.basic
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"])
--- expect
SELECT `dept` FROM `items` GROUP BY `dept`
===

### name: stmt.bucket.multi-list
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "CATEGORY": {"kind": "column", "column": "category", "type": "TEXT"}}}}
--- as
statement
--- source
ITEMS .> BUCKET((_["dept"], _["category"]))
--- expect
SELECT `dept`, `category` FROM `items` GROUP BY `dept`, `category`
===

### name: stmt.bucket.multi-record
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "CATEGORY": {"kind": "column", "column": "category", "type": "TEXT"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(RECORD("dept", _["dept"], "category", _["category"]))
--- expect
SELECT `dept` AS `dept`, `category` AS `category` FROM `items` GROUP BY `dept`, `category`
===

### name: stmt.bucket.aggregates
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"], RECORD("dept", _K, "cnt", COUNT(_), "total", SUM(_, _["amount"])))
--- expect
SELECT `dept` AS `dept`, COUNT(*) AS `cnt`, COALESCE(SUM(`amount`), 0) AS `total` FROM `items` GROUP BY `dept`
===

### name: stmt.bucket.custom-binder
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(r, r["dept"], RECORD("dept", _K, "total", SUM(r, x, x["amount"])))
--- expect
SELECT `dept` AS `dept`, COALESCE(SUM(`amount`), 0) AS `total` FROM `items` GROUP BY `dept`
===

### name: stmt.bucket.where-and-having
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}, "ACTIVE": {"kind": "column", "column": "active", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> FILTER(_["active"] == 1) .> BUCKET(_["dept"], RECORD("dept", _K, "total", SUM(_, _["amount"]))) .> FILTER(_["total"] > 100)
--- expect
SELECT `dept` AS `dept`, COALESCE(SUM(`amount`), 0) AS `total` FROM `items` WHERE (`active` = 1) GROUP BY `dept` HAVING (COALESCE(SUM(`amount`), 0) > 100)
===

### name: stmt.bucket.order-by-agg
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"], RECORD("dept", _K, "total", SUM(_, _["amount"]))) .> SORT_BY(_["total"], "DESC")
--- expect
SELECT `dept` AS `dept`, COALESCE(SUM(`amount`), 0) AS `total` FROM `items` GROUP BY `dept` ORDER BY COALESCE(SUM(`amount`), 0) DESC
===

### name: stmt.bucket.pagination
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> TAKE(10) .> DROP(5)
--- expect
SELECT `dept` FROM `items` GROUP BY `dept` LIMIT 10 OFFSET 5
===

### name: stmt.bucket.dialect-postgres
--- dialect
postgresql
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}, "ACTIVE": {"kind": "column", "column": "active", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> FILTER(_["active"] == 1) .> BUCKET(_["dept"], RECORD("dept", _K, "total", SUM(_, _["amount"]))) .> FILTER(_["total"] > 100) .> SORT_BY(_["total"], "DESC")
--- expect
SELECT "dept" AS "dept", COALESCE(SUM("amount"), 0) AS "total" FROM "items" WHERE ("active" = 1) GROUP BY "dept" HAVING (COALESCE(SUM("amount"), 0) > 100) ORDER BY COALESCE(SUM("amount"), 0) DESC
===

### name: stmt.bucket.dialect-sqlite
--- dialect
sqlite
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"], RECORD("dept", _K, "cnt", COUNT(_))) .> DROP(5)
--- expect
SELECT "dept" AS "dept", COUNT(*) AS "cnt" FROM "items" GROUP BY "dept" LIMIT -1 OFFSET 5
===

### name: stmt.bucket.dialect-mysql
--- dialect
mysql
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"], RECORD("dept", _K, "total", SUM(_, _["amount"]))) .> DROP(5)
--- expect
SELECT `dept` AS `dept`, COALESCE(SUM(`amount`), 0) AS `total` FROM `items` GROUP BY `dept` LIMIT 18446744073709551615 OFFSET 5
===

### name: stmt.bucket.refusal-binder
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(123, _["dept"], _["dept"])
--- error
E_SQL_SHAPE 1:17
===

### name: stmt.bucket.refusal-having-bool
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> FILTER("not a bool")
--- error
E_SQL_SHAPE 1:31
===

### name: stmt.bucket.refusal-unknown-field
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["unknown_col"])
--- error
E_SQL_BINDING 1:18
===

### name: stmt.bucket.pipeline-map-is-the-projection
--- note
BUCKET(src, key) .> MAP(proj) and BUCKET(src, key, proj) are one value in the
evaluator -- the MAP's body runs once per group with _ the group and _K its
key -- so they are one statement here. Before this the bare bucket was
rendered as its keys and the MAP was laid over that as a derived table, which
counted one row per group and, worse, was accepted for a body SEL refuses.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> MAP(RECORD("dept", _K, "cnt", COUNT(_)))
--- expect
SELECT `dept` AS `dept`, COUNT(*) AS `cnt` FROM `items` GROUP BY `dept`
===

### name: stmt.bucket.pipeline-filter-then-map
--- note
A FILTER between the bucket and its MAP is a HAVING: it sees the group, and
the MAP still closes the bucket.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> FILTER(COUNT(_) > 1) .> MAP(RECORD("dept", _K, "total", SUM(_, _["amount"])))
--- expect
SELECT `dept` AS `dept`, COALESCE(SUM(`amount`), 0) AS `total` FROM `items` GROUP BY `dept` HAVING (COUNT(*) > 1)
===

### name: stmt.bucket.pipeline-map-names-the-group
--- note
The MAP may name the group; _K is still the key, written against the key's
own binder.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}, "AMOUNT": {"kind": "column", "column": "amount", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> MAP(g, RECORD("dept", _K, "total", SUM(g, x, x["amount"])))
--- expect
SELECT `dept` AS `dept`, COALESCE(SUM(`amount`), 0) AS `total` FROM `items` GROUP BY `dept`
===

### name: stmt.bucket.refuse-map-after-the-members-are-spent
--- note
Once anything but a FILTER follows a bare bucket, SQL has only the keys left;
a MAP after that would run over rows SEL calls groups, so it is refused
rather than translated into a different program.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> TAKE(2) .> MAP(RECORD("dept", _K))
--- error
E_SQL_SHAPE 1:42
===
### name: stmt.bucket.refuse-bucket-over-an-open-bucket
--- note
Review 2026-09-15 finding AI. A second BUCKET over a bare bucket used to
discard the plan's bucket state and group the key rows again -- `GROUP BY
COUNT(*)`, which the database rejects, or a re-grouping of keys SEL calls
groups. Either way a different program; refused at the second BUCKET.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> BUCKET(COUNT(_)) .> MAP(RECORD("size", _K, "n", COUNT(_)))
--- error
E_SQL_SHAPE 1:31
===
### name: stmt.bucket.refuse-projected-bucket-over-an-open-bucket
--- note
The three-argument spelling is the same second bucket.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> BUCKET(COUNT(_), RECORD("size", _K, "n", COUNT(_)))
--- error
E_SQL_SHAPE 1:31
===
### name: stmt.bucket.refuse-bucket-over-a-sealed-bucket
--- note
And once the members are spent (a TAKE followed the bare bucket) a BUCKET is
refused like the MAP in refuse-map-after-the-members-are-spent.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> TAKE(2) .> BUCKET(_["dept"])
--- error
E_SQL_SHAPE 1:42
===
### name: stmt.bucket.bucket-over-a-projected-bucket
--- note
A bucket whose projection closed it is a list of records again, and a second
BUCKET over that list is ordinary re-grouping: the grouped statement becomes
a derived table.
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"DEPT": {"kind": "column", "column": "dept", "type": "TEXT"}}}}
--- as
statement
--- source
ITEMS .> BUCKET(_["dept"]) .> MAP(RECORD("dept", _K, "n", COUNT(_))) .> BUCKET(_["n"]) .> MAP(RECORD("n", _K, "depts", COUNT(_)))
--- expect
SELECT `_sub1`.`n` AS `n`, COUNT(*) AS `depts` FROM (SELECT `dept` AS `dept`, COUNT(*) AS `n` FROM `items` GROUP BY `dept`) `_sub1` GROUP BY `_sub1`.`n`
===
