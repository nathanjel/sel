### name: plan.latest-member.inherited.ansi-child
--- note
Every clause of the statement is SQL:1999, so ansi spells it and a dialect registered on ansi inherits the plan.
--- dialect
ansi-probe
--- register
[{"dialect": "ansi-probe", "extends": "ansi", "version": "1", "target": true}]
--- bindings
{"R":{"kind":"relation","from":"r","uniqueKey":"id","fields":{"ID":{"kind":"column","column":"id","type":"NUM"},"FK":{"kind":"column","column":"fk","type":"TEXT"}}}}
--- source
R .> BUCKET(_["fk"]) .> MAP(RECORD("entity", _K, "latest", TOP_BY(_, _["id"], "DESC", 1)))
--- plan
hybrid
--- tables
r
--- expect
WITH "_sel_input" AS (SELECT * FROM "r" WHERE TRUE), "_sel_latest" AS (SELECT MAX("id") AS "_sel_revision", MIN("id") AS "_sel_first" FROM "_sel_input" GROUP BY CAST("fk" AS CHARACTER VARYING) COLLATE UCS_BASIC) SELECT "_sel_input".* FROM "_sel_input" JOIN "_sel_latest" ON "_sel_input"."id" = "_sel_latest"."_sel_revision" ORDER BY "_sel_latest"."_sel_first" ASC
===
