--- dialect
postgresql
--- bindings
{"R": {"kind": "relation", "from": "r", "fields": {"N": {"kind": "column", "column": "n", "type": "NUM"}, "T": {"kind": "column", "column": "t", "type": "TEXT"}}}}
--- options
{"strict": true}
--- as
statement
--- source
R .> MAP(RECORD("k", CANON(_["n"]))) .> SORT_BY(_["k"])
