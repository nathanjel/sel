### name: func.canon.ansi.num-column
--- dialect
ansi-probe
--- register
[{"dialect": "ansi-probe", "extends": "ansi", "version": "1", "target": true}]
--- bindings
{"N": {"kind": "column", "table": "r", "column": "n", "type": "NUM"}, "T": {"kind": "column", "table": "r", "column": "t", "type": "TEXT"}}
--- source
CANON(N)
--- expect
CASE WHEN POSITION('.' IN CAST(CAST("r"."n" AS NUMERIC) AS CHARACTER VARYING)) > 0 THEN TRIM(TRAILING '.' FROM TRIM(TRAILING '0' FROM CAST(CAST("r"."n" AS NUMERIC) AS CHARACTER VARYING))) ELSE CAST(CAST("r"."n" AS NUMERIC) AS CHARACTER VARYING) END
===

