CANON(TRUE)
--- error
E_SQL_SHAPE 1:7
===

### name: canon.dedupe.postgresql
--- note
DISTINCT over a numeric column is refused (1 and 1.0 are two values in SEL
and one in SQL); over its canonical form it is exact, and stays numeric.
--- dialect
postgresql
--- bindings
{"R": {"kind": "relation", "from": "r", "fields": {"N": {"kind": "column", "column": "n", "type": "NUM"}, "T": {"kind": "column", "column": "t", "type": "TEXT"}}}}
--- as
statement
--- source
R .> MAP(RECORD("k", CANON(_["n"]))) .> DEDUPE()
--- expect
SELECT DISTINCT trim_scale(CAST("n" AS NUMERIC)) AS "k" FROM "r"
===

### name: canon.dedupe.mariadb
--- dialect
mariadb
--- bindings
{"R": {"kind": "relation", "from": "r", "fields": {"N": {"kind": "column", "column": "n", "type": "NUM"}, "T": {"kind": "column", "column": "t", "type": "TEXT"}}}}
--- as
statement
--- source
R .> MAP(RECORD("k", CANON(_["n"]))) .> DEDUPE()
--- expect
SELECT DISTINCT CAST(REGEXP_REPLACE(REGEXP_SUBSTR(REGEXP_REPLACE(CAST(`n` AS CHAR), '(?<=^-)0+(?=[0-9])|^0+(?=[0-9])', ''), '^-?[0-9]+(\\.[0-9]*[1-9])?'), '^-0$', '0') AS CHAR) COLLATE utf8mb4_nopad_bin AS `k` FROM `r`
===

### name: canon.dedupe.sqlite
--- dialect
sqlite
--- bindings
{"R": {"kind": "relation", "from": "r", "fields": {"N": {"kind": "column", "column": "n", "type": "NUM"}, "T": {"kind": "column", "column": "t", "type": "TEXT"}}}}
--- as
statement
--- source
R .> MAP(RECORD("k", CANON(_["n"]))) .> DEDUPE()
--- expect
SELECT DISTINCT CAST((SELECT CASE WHEN canon_n = 0 THEN '0' WHEN instr(canon_s, '.') > 0 THEN rtrim(rtrim(canon_s, '0'), '.') ELSE canon_s END FROM (SELECT canon_n, CAST(canon_n AS TEXT) AS canon_s FROM (SELECT CAST("n" AS NUMERIC) AS canon_n))) AS TEXT) COLLATE BINARY AS "k" FROM "r"
===

### name: canon.dedupe.of-arithmetic.postgresql
--- note
Arithmetic changes a value's scale, and so its SEL identity; its canonical
form does not depend on the scale.
--- dialect
postgresql
--- bindings
{"R": {"kind": "relation", "from": "r", "fields": {"N": {"kind": "column", "column": "n", "type": "NUM"}, "T": {"kind": "column", "column": "t", "type": "TEXT"}}}}
--- as
statement
--- source
R .> MAP(RECORD("k", CANON(_["n"] * 1.0 + 0.50))) .> DEDUPE()
--- expect
SELECT DISTINCT trim_scale(CAST((CAST((CAST("n" AS NUMERIC) * CAST(1.0 AS NUMERIC)) AS NUMERIC) + CAST(0.50 AS NUMERIC)) AS NUMERIC)) AS "k" FROM "r"
===

### name: canon.bucket.postgresql
--- note
A computed numeric group key is refused; a canonical one is exact, grouped
as the number it is.
--- dialect
postgresql
--- bindings
{"R": {"kind": "relation", "from": "r", "fields": {"N": {"kind": "column", "column": "n", "type": "NUM"}, "T": {"kind": "column", "column": "t", "type": "TEXT"}}}}
--- as
statement
--- source
R .> BUCKET(CANON(_["n"]), RECORD("k", _K, "c", COUNT(_)))
--- expect
SELECT MIN(trim_scale(CAST("n" AS NUMERIC))) AS "k", COUNT(*) AS "c" FROM "r" GROUP BY trim_scale(CAST("n" AS NUMERIC))
===

### name: canon.bucket.mariadb
--- dialect
mariadb
--- bindings
{"R": {"kind": "relation", "from": "r", "fields": {"N": {"kind": "column", "column": "n", "type": "NUM"}, "T": {"kind": "column", "column": "t", "type": "TEXT"}}}}
--- as
statement
--- source
R .> BUCKET(CANON(_["n"]), RECORD("k", _K, "c", COUNT(_)))
--- expect
SELECT CAST(REGEXP_REPLACE(REGEXP_SUBSTR(REGEXP_REPLACE(CAST(`n` AS CHAR), '(?<=^-)0+(?=[0-9])|^0+(?=[0-9])', ''), '^-?[0-9]+(\\.[0-9]*[1-9])?'), '^-0$', '0') AS CHAR) COLLATE utf8mb4_nopad_bin AS `k`, COUNT(*) AS `c` FROM `r` GROUP BY CAST(REGEXP_REPLACE(REGEXP_SUBSTR(REGEXP_REPLACE(CAST(`n` AS CHAR), '(?<=^-)0+(?=[0-9])|^0+(?=[0-9])', ''), '^-?[0-9]+(\\.[0-9]*[1-9])?'), '^-0$', '0') AS CHAR) COLLATE utf8mb4_nopad_bin
===

### name: canon.bucket.of-arithmetic.mariadb
--- dialect
mariadb
--- bindings
{"R": {"kind": "relation", "from": "r", "fields": {"N": {"kind": "column", "column": "n", "type": "NUM"}, "T": {"kind": "column", "column": "t", "type": "TEXT"}}}}
--- as
statement
--- source
R .> BUCKET(CANON(_["n"] + 0.5), RECORD("k", _K, "c", COUNT(_)))
--- expect
SELECT CAST(REGEXP_REPLACE(REGEXP_SUBSTR(REGEXP_REPLACE(CAST((`n` + 0.5) AS CHAR), '(?<=^-)0+(?=[0-9])|^0+(?=[0-9])', ''), '^-?[0-9]+(\\.[0-9]*[1-9])?'), '^-0$', '0') AS CHAR) COLLATE utf8mb4_nopad_bin AS `k`, COUNT(*) AS `c` FROM `r` GROUP BY CAST(REGEXP_REPLACE(REGEXP_SUBSTR(REGEXP_REPLACE(CAST((`n` + 0.5) AS CHAR), '(?<=^-)0+(?=[0-9])|^0+(?=[0-9])', ''), '^-?[0-9]+(\\.[0-9]*[1-9])?'), '^-0$', '0') AS CHAR) COLLATE utf8mb4_nopad_bin
===

### name: canon.sort.postgresql
--- note
Numeric on PostgreSQL, so it sorts as SEL sorts it, exactly.
--- dialect
postgresql
--- bindings
{"R": {"kind": "relation", "from": "r", "fields": {"N": {"kind": "column", "column": "n", "type": "NUM"}, "T": {"kind": "column", "column": "t", "type": "TEXT"}}}}
--- options
{"strict": true}
--- as
statement
--- source
R .> SORT_BY(CANON(_["n"]))
--- expect
SELECT * FROM "r" ORDER BY trim_scale(CAST("n" AS NUMERIC)) ASC
===

### name: canon.sort.mariadb-is-refused
--- note
Text on the MySQL family, which SQL sorts by its bytes ("10" before "9")
where SEL sorts it as the number it is. Refused, so the planner sorts in
memory.
