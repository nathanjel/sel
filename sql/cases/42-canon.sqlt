% CANON(x) in SQL (spec §7.6). A number's canonical form is one spelling per
% value, so it is the one computed value whose SQL identity can be proved:
% DISTINCT and GROUP BY over it are exact, and the planner's identity barrier
% lets it through (docs/SQL-TRANSLATION.md, "A value a grouping or a whole-row
% comparison reads keeps SEL's identity").
%
% Where each spelling comes from, and what verified it (SEL-0058): every valid
% input through a typed numeric column, arithmetic over it, the dialect's
% numeric guard over text, and literals, on PostgreSQL 17, MariaDB 11.8,
% MySQL 8.4 and SQLite 3.51, and the ANSI spelling on PostgreSQL through the
% probe dialect.
%
%   postgresql  trim_scale of the number: numeric, and its scale is the value's.
%   mysql       the value's text, trimmed by a regex chain with no backreference
%               (MariaDB and MySQL spell those differently): text, because a
%               DECIMAL's scale belongs to its type, not to the value.
%   sqlite      the number's text, trimmed: text, and caveated decimal-float,
%               as every SQLite number is; the float it holds past 15 digits
%               or in exponent form is not SEL's number.
%   ansi        CAST, POSITION and TRIM, all standard: text.
%
% The argument is a numeric argument like ABS's: a text operand is guarded
% where the dialect can ask whether it is a number, and refused where it
% cannot (sqlite, ansi).

### name: func.canon.postgresql.num-column
--- dialect
postgresql
--- bindings
{"N": {"kind": "column", "table": "r", "column": "n", "type": "NUM"}, "T": {"kind": "column", "table": "r", "column": "t", "type": "TEXT"}}
--- source
CANON(N)
--- expect
trim_scale(CAST("r"."n" AS NUMERIC))
===

### name: func.canon.postgresql.text-column-is-guarded
--- note
A text operand is read as a number only through the guard, as ABS reads one.
--- dialect
postgresql
--- bindings
{"N": {"kind": "column", "table": "r", "column": "n", "type": "NUM"}, "T": {"kind": "column", "table": "r", "column": "t", "type": "TEXT"}}
--- source
CANON(T)
--- expect
trim_scale(CAST(CASE WHEN (CAST("r"."t" AS TEXT) ~ '^-?[0-9]+(\.[0-9]+)?$') THEN CAST("r"."t" AS NUMERIC) ELSE NULL END AS NUMERIC))
===

### name: func.canon.postgresql.constant
--- dialect
postgresql
--- source
CANON(1.50)
--- expect
trim_scale(CAST(1.50 AS NUMERIC))
===

### name: func.canon.postgresql.text-constant
--- dialect
postgresql
--- source
CANON("007")
--- expect
trim_scale(CAST('007' AS NUMERIC))
===

### name: func.canon.postgresql.exact-under-strict
--- dialect
postgresql
--- bindings
{"N": {"kind": "column", "table": "r", "column": "n", "type": "NUM"}, "T": {"kind": "column", "table": "r", "column": "t", "type": "TEXT"}}
--- options
{"strict": true}
--- source
CANON(N)
--- expect
trim_scale(CAST("r"."n" AS NUMERIC))
===

### name: func.canon.mariadb.num-column
--- dialect
mariadb
--- bindings
{"N": {"kind": "column", "table": "r", "column": "n", "type": "NUM"}, "T": {"kind": "column", "table": "r", "column": "t", "type": "TEXT"}}
--- source
CANON(N)
--- expect
REGEXP_REPLACE(REGEXP_SUBSTR(REGEXP_REPLACE(CAST(`r`.`n` AS CHAR), '(?<=^-)0+(?=[0-9])|^0+(?=[0-9])', ''), '^-?[0-9]+(\\.[0-9]*[1-9])?'), '^-0$', '0')
===

### name: func.canon.mariadb.text-column-is-guarded
--- dialect
mariadb
--- bindings
{"N": {"kind": "column", "table": "r", "column": "n", "type": "NUM"}, "T": {"kind": "column", "table": "r", "column": "t", "type": "TEXT"}}
--- source
CANON(T)
--- expect
REGEXP_REPLACE(REGEXP_SUBSTR(REGEXP_REPLACE(CAST(CASE WHEN (`r`.`t` REGEXP '\\A-?[0-9]+(\\.[0-9]+)?\\z') THEN CAST(`r`.`t` AS DECIMAL(65,10)) ELSE NULL END AS CHAR), '(?<=^-)0+(?=[0-9])|^0+(?=[0-9])', ''), '^-?[0-9]+(\\.[0-9]*[1-9])?'), '^-0$', '0')
===

### name: func.canon.mariadb.constant
--- dialect
mariadb
--- source
CANON(1.50)
--- expect
REGEXP_REPLACE(REGEXP_SUBSTR(REGEXP_REPLACE(CAST(1.50 AS CHAR), '(?<=^-)0+(?=[0-9])|^0+(?=[0-9])', ''), '^-?[0-9]+(\\.[0-9]*[1-9])?'), '^-0$', '0')
===

### name: func.canon.mariadb.text-constant
--- note
A text constant arrives with its leading zeros; the chain drops them.
--- dialect
mariadb
--- source
CANON("007")
--- expect
REGEXP_REPLACE(REGEXP_SUBSTR(REGEXP_REPLACE(CAST('007' AS CHAR), '(?<=^-)0+(?=[0-9])|^0+(?=[0-9])', ''), '^-?[0-9]+(\\.[0-9]*[1-9])?'), '^-0$', '0')
===

### name: func.canon.mariadb.exact-under-strict
--- dialect
mariadb
--- bindings
{"N": {"kind": "column", "table": "r", "column": "n", "type": "NUM"}, "T": {"kind": "column", "table": "r", "column": "t", "type": "TEXT"}}
--- options
{"strict": true}
--- source
CANON(N)
--- expect
REGEXP_REPLACE(REGEXP_SUBSTR(REGEXP_REPLACE(CAST(`r`.`n` AS CHAR), '(?<=^-)0+(?=[0-9])|^0+(?=[0-9])', ''), '^-?[0-9]+(\\.[0-9]*[1-9])?'), '^-0$', '0')
===

### name: func.canon.mariadb.guarded-text-is-scale-limited
--- note
The guard reads a text operand as DECIMAL(65,10), so a text number with more
than ten fractional digits loses them before CANON sees it (scale-limit).
--- dialect
mariadb
--- bindings
{"N": {"kind": "column", "table": "r", "column": "n", "type": "NUM"}, "T": {"kind": "column", "table": "r", "column": "t", "type": "TEXT"}}
--- options
{"strict": true}
--- source
CANON(T)
--- error
E_SQL_UNSUPPORTED 1:7
===

### name: func.canon.sqlite.num-column
--- dialect
sqlite
--- bindings
{"N": {"kind": "column", "table": "r", "column": "n", "type": "NUM"}, "T": {"kind": "column", "table": "r", "column": "t", "type": "TEXT"}}
--- source
CANON(N)
--- expect
(SELECT CASE WHEN canon_n = 0 THEN '0' WHEN instr(canon_s, '.') > 0 THEN rtrim(rtrim(canon_s, '0'), '.') ELSE canon_s END FROM (SELECT canon_n, CAST(canon_n AS TEXT) AS canon_s FROM (SELECT CAST("r"."n" AS NUMERIC) AS canon_n)))
===

### name: func.canon.sqlite.constant
--- dialect
sqlite
--- source
CANON(1.50)
--- expect
(SELECT CASE WHEN canon_n = 0 THEN '0' WHEN instr(canon_s, '.') > 0 THEN rtrim(rtrim(canon_s, '0'), '.') ELSE canon_s END FROM (SELECT canon_n, CAST(canon_n AS TEXT) AS canon_s FROM (SELECT CAST('1.50' AS NUMERIC) AS canon_n)))
===

### name: func.canon.sqlite.text-constant
--- dialect
sqlite
--- source
CANON("007")
--- expect
(SELECT CASE WHEN canon_n = 0 THEN '0' WHEN instr(canon_s, '.') > 0 THEN rtrim(rtrim(canon_s, '0'), '.') ELSE canon_s END FROM (SELECT canon_n, CAST(canon_n AS TEXT) AS canon_s FROM (SELECT CAST('007' AS NUMERIC) AS canon_n)))
===

