### name: stmt.correlate
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "alias": "i", "correlate": "i.order_id = o.id", "fields": {"TOTAL": {"kind": "column", "table": "i", "column": "total", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> FILTER(_["total"] > 10)
--- expect
SELECT `i`.* FROM `items` `i` WHERE i.order_id = o.id AND (`i`.`total` > 10)
===

### name: stmt.params.mode
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"TOTAL": {"kind": "column", "column": "total", "type": "NUM"}, "NAME": {"kind": "column", "column": "name", "type": "TEXT", "exact": true}}}}
--- as
statement
--- mode
params
--- source
ITEMS .> FILTER(_["total"] > 100) .> FILTER(_["name"] $== "foo")
--- expect
SELECT * FROM `items` WHERE (`total` > 100) AND (`name` = ?)
--- params
t"foo"
===

### name: stmt.params.order-by
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"NAME": {"kind": "column", "column": "name", "type": "TEXT", "exact": true}}}}
--- as
statement
--- mode
debug
--- source
ITEMS .> FILTER(_["name"] $== "foo") .> SORT_BY(_["name"] & "bar")
--- expect
SELECT * FROM `items` WHERE (`name` = ~1~) ORDER BY CAST(CONCAT(`name`, ~2~) AS CHAR) COLLATE utf8mb4_bin ASC
===

