# Statements: relational pipeline to SELECT queries.
#
# Covers top-level statement compilation across dialects:
# sources, projections (SELECT_COLS, MAP(RECORD(...))),
# filters, ordering, pagination (TAKE, DROP), and distinct.

### name: stmt.basic.star
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items"}}
--- as
statement
--- source
ITEMS
--- expect
SELECT * FROM `items`
===

### name: stmt.basic.alias
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "alias": "i"}}
--- as
statement
--- source
ITEMS
--- expect
SELECT `i`.* FROM `items` `i`
===

### name: stmt.select-cols.single
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"ID": {"kind": "column", "column": "id"}}}}
--- as
statement
--- source
ITEMS .> SELECT_COLS("id")
--- expect
SELECT `id` FROM `items`
===

### name: stmt.select-cols.multi
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"ID": {"kind": "column", "column": "id"}, "TOTAL": {"kind": "column", "column": "total"}}}}
--- as
statement
--- source
ITEMS .> SELECT_COLS("id", "total")
--- expect
SELECT `id`, `total` FROM `items`
===

### name: stmt.select-cols.list
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"ID": {"kind": "column", "column": "id"}, "TOTAL": {"kind": "column", "column": "total"}}}}
--- as
statement
--- source
ITEMS .> SELECT_COLS(("id", "total"))
--- expect
SELECT `id`, `total` FROM `items`
===

### name: stmt.select-cols.with-alias
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "alias": "i", "fields": {"ID": {"kind": "column", "column": "id"}, "TOTAL": {"kind": "column", "column": "total"}}}}
--- as
statement
--- source
ITEMS .> SELECT_COLS("id", "total")
--- expect
SELECT `i`.`id`, `i`.`total` FROM `items` `i`
===

### name: stmt.filter.default-binder
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"TOTAL": {"kind": "column", "column": "total", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> FILTER(_["total"] > 100)
--- expect
SELECT * FROM `items` WHERE (`total` > 100)
===

### name: stmt.filter.custom-binder
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"TOTAL": {"kind": "column", "column": "total", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> FILTER(x, x["total"] > 100)
--- expect
SELECT * FROM `items` WHERE (`total` > 100)
===

### name: stmt.filter.multi
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"ID": {"kind": "column", "column": "id", "type": "NUM"}, "TOTAL": {"kind": "column", "column": "total", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> FILTER(_["total"] > 100) .> FILTER(_["id"] == 1)
--- expect
SELECT * FROM `items` WHERE (`total` > 100) AND (`id` = 1)
===

### name: stmt.map.scalar
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"TOTAL": {"kind": "column", "column": "total", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> MAP(_["total"] * 2)
--- expect
SELECT (`total` * 2) FROM `items`
===

### name: stmt.map.record
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"ID": {"kind": "column", "column": "id"}, "TOTAL": {"kind": "column", "column": "total", "type": "NUM"}}}}
--- as
statement
--- source
ITEMS .> MAP(RECORD("doubled", _["total"] * 2, "ident", _["id"]))
--- expect
SELECT (`total` * 2) AS `doubled`, `id` AS `ident` FROM `items`
===

### name: stmt.distinct
--- dialect
mariadb
--- bindings
{"ITEMS": {"kind": "relation", "from": "items", "fields": {"ID": {"kind": "column", "column": "id"}}}}
--- as
statement
--- source
ITEMS .> SELECT_COLS("id") .> DISTINCT()
--- expect
SELECT DISTINCT `id` FROM `items`
===

### name: stmt.order-by.sort-by-asc
