--- bindings
{"ORDERS":{"kind":"relation","from":"orders","alias":"o","fields":{"ID":{"table":"o","column":"id","type":"NUM"},"CUSTOMER_ID":{"table":"o","column":"customer_id","type":"NUM"},"NAME":{"table":"o","column":"name","type":"TEXT"}}},"CUSTOMERS":{"kind":"relation","from":"customers","alias":"c","fields":{"ID":{"table":"c","column":"id","type":"NUM"},"NAME":{"table":"c","column":"name","type":"TEXT"}}},"PLAIN":{"kind":"relation","from":"plain","fields":{"ID":{"column":"id","type":"NUM"},
 "V":{"column":"v","type":"NUM"}}}}
