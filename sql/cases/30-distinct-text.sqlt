### name: stmt.text-identity.distinct-record.mariadb
--- dialect
mariadb
--- options
{"strict":true}
--- bindings
{"R":{"kind":"relation","from":"r","fields":{"CAT":{"kind":"column","column":"cat","type":"TEXT"}}}}
--- as
statement
--- source
R .> MAP(RECORD("cat", _["cat"])) .> DISTINCT()
--- expect
SELECT DISTINCT CAST(`cat` AS CHAR) COLLATE utf8mb4_nopad_bin AS `cat` FROM `r`
===

