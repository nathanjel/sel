### name: stmt.numeric-identity.derived-pass-through.sqlite
--- dialect
sqlite
--- options
{"strict":true}
--- bindings
{"R":{"kind":"relation","from":"r","fields":{"V":{"kind":"column","column":"v","type":"NUM"}}}}
--- as
statement
--- source
R .> MAP(RECORD("key", _["v"])) .> BUCKET(_["key"], RECORD("key", _K, "n", COUNT(_)))
--- expect
SELECT MIN("_sub1"."key") AS "key", COUNT(*) AS "n" FROM (SELECT "v" AS "key" FROM "r") "_sub1" GROUP BY CAST("_sub1"."key" AS TEXT) COLLATE BINARY
===

### name: plan.group-identity.unknown-derived-prefix.sqlite
--- dialect
