R = RECORD("K1", 1, "K2", 2, "K3", 3, "K4", 4, "K5", 5, "K6", 6, "K7", 7, "K8", 8, "K9", 9, "K10", 10, "K11", 11, "K12", 12, "K13", 13, "K14", 14, "K15", 15, "K16", 16, "K17", 17, "K18", 18, "K19", 19, "K20", 20); R["Z"] = 5; S = RECORD("K1", 1, "K2", 2, "K3", 3, "K4", 4, "K5", 5, "K6", 6, "K7", 7, "K8", 8, "K9", 9, "K10", 10, "K11", 11, "K12", 12, "K13", 13, "K14", 14, "K15", 15, "K16", 16, "K17", 17, "K18", 18, "K19", 19, "K20", 20); S["Z"]
