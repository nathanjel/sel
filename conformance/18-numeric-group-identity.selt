### name: rel.numeric-group-identity.projected
--- source
LIST("1", "1.0", "1.00") .> BUCKET(_ + 0, RECORD("key", _K, "n", COUNT(_)))
--- expect
tree -{"1"=-{"key"=t"1", "n"=t"1"}, "2"=-{"key"=t"1.0", "n"=t"1"}, "3"=-{"key"=t"1.00", "n"=t"1"}}
===

### name: rel.numeric-group-identity.bare-then-map
--- source
LIST("1", "1.0", "1.00") .> BUCKET(_ + 0) .> MAP(RECORD("key", _K, "n", COUNT(_)))
--- expect
tree -{"1"=-{"key"=t"1", "n"=t"1"}, "2"=-{"key"=t"1.0", "n"=t"1"}, "3"=-{"key"=t"1.00", "n"=t"1"}}
===

### name: rel.numeric-group-identity.zero-and-leading-zero
--- source
LIST("0", "-0", "0.0", "-0.0", "01", "1.0") .> BUCKET(_ + 0, RECORD("key", _K, "n", COUNT(_)))
--- expect
tree -{"1"=-{"key"=t"0", "n"=t"2"}, "2"=-{"key"=t"0.0", "n"=t"2"}, "3"=-{"key"=t"1", "n"=t"1"}, "4"=-{"key"=t"1.0", "n"=t"1"}}
===
