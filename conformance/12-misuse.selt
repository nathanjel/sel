CEIL(TRUE)
--- expect
error E_NOT_NUM at 1:6
===
### name: mis.not-num.floor
--- source
FLOOR(TRUE)
--- expect
error E_NOT_NUM at 1:7
===
### name: mis.not-num.trunc
--- source
TRUNC(TRUE)
--- expect
error E_NOT_NUM at 1:7
===
### name: mis.not-num.round-value
--- source
ROUND(TRUE, 0)
--- expect
error E_NOT_NUM at 1:7
===
### name: mis.not-num.power-base
--- source
POWER(TRUE, 2)
--- expect
error E_NOT_NUM at 1:7
===
### name: mis.not-num.min
--- source
MIN(TRUE)
--- expect
error E_NOT_NUM at 1:5
===
### name: mis.not-num.min-later
--- source
MIN(1, TRUE)
--- expect
error E_NOT_NUM at 1:8
===
### name: mis.not-num.max
--- source
MAX(TRUE)
--- expect
error E_NOT_NUM at 1:5
===
### name: mis.not-num.max-later
--- source
MAX(1, TRUE)
--- expect
error E_NOT_NUM at 1:8
===
### name: mis.not-num.sum-body
--- source
SUM((1), _ & "x")
--- expect
error E_NOT_NUM at 1:12
===
### name: mis.not-num.add
--- source
1 + TRUE
--- expect
error E_NOT_NUM at 1:5
===
### name: mis.not-num.mul
--- source
