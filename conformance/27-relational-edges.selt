--- note
The same for the descending spelling, where a tie keeps its input order too.
--- source
L = LIST(RECORD("k", 3, "id", "a"), RECORD("k", 1, "id", "b"), RECORD("k", 3, "id", "c"), RECORD("k", 2, "id", "d"), RECORD("k", 1, "id", "e")); TOP_BY(L, _["k"], "DESC", 1) EQL TAKE(SORT_BY(L, _["k"], "DESC"), 1)
--- expect
bool TRUE
===
