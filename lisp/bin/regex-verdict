#!/usr/bin/env bash
# See regex-verdict.lisp beside this wrapper. Run from the repository root.
here="$(cd "$(dirname "$0")" && pwd)"
exec sbcl --dynamic-space-size 4GB --noinform --disable-debugger --non-interactive \
  --load "$here/boot.lisp" \
  --load "$here/regex-verdict.lisp" \
  --eval '(sel-cli:main)' \
  --end-toplevel-options "$@"
