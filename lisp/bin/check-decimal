#!/usr/bin/env bash
# See check-decimal.lisp beside this wrapper. Run from the repository root.
here="$(cd "$(dirname "$0")" && pwd)"
exec sbcl --noinform --disable-debugger --non-interactive \
  --load "$here/boot.lisp" \
  --load "$here/check-decimal.lisp" \
  --eval '(sel-cli:main)' \
  --end-toplevel-options "$@"
