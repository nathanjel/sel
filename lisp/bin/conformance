#!/usr/bin/env bash
# Runs the normative conformance suite against the Common Lisp implementation.
# Run from the repository root, where conformance/ lives.
here="$(cd "$(dirname "$0")" && pwd)"
exec sbcl --noinform --disable-debugger --non-interactive \
  --load "$here/boot.lisp" \
  --load "$here/conformance.lisp" \
  --eval '(sel-cli:main)' \
  --end-toplevel-options "$@"
