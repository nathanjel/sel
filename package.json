{
  "name": "sel-lang",
  "version": "0.8.0",
  "description": "A small expression language for validation rules — one rule file evaluates identically on JavaScript, PHP, Python, C++23 and Common Lisp. Exact decimal arithmetic, no floating point, no truthiness.",
  "keywords": [
    "validation",
    "rules",
    "rule-engine",
    "expression-language",
    "interpreter",
    "decimal",
    "exact-arithmetic",
    "isomorphic",
    "shared-validation"
  ],
  "homepage": "https://github.com/nathanjel/sel#readme",
  "bugs": "https://github.com/nathanjel/sel/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nathanjel/sel.git"
  },
  "license": "MIT",
  "author": "Marcin Gałczyński",
  "type": "module",
  "types": "./js/src/sel.d.ts",
  "exports": {
    ".": {
      "types": "./js/src/sel.d.ts",
      "default": "./js/src/sel.mjs"
    },
    "./sql": {
      "types": "./js/src/sql.d.ts",
      "default": "./js/src/sql/index.mjs"
    },
    "./package.json": "./package.json",
    "./bundle": "./dist/sel.mjs",
    "./bundle.min": "./dist/sel.min.mjs"
  },
  "bin": {
    "sel": "js/bin/sel.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "./js/src/builtins/*.mjs"
  ],
  "files": [
    "dist/sel.mjs",
    "dist/sel.min.mjs",
    "js/src/",
    "js/bin/",
    "conformance/",
    "docs/README.md",
    "docs/overview.md",
    "docs/parity.md",
    "docs/syntax.md",
    "docs/operators.md",
    "docs/functions.md",
    "docs/sql.md",
    "docs/extending.md",
    "docs/usage/README.md",
    "docs/usage/repl.md",
    "docs/usage/validation.md",
    "docs/usage/scripting.md",
    "docs/usage/sql-conditions.md",
    "docs/usage/sql-pipelines.md",
    "docs/usage/sql-star.md",
    "docs/usage/sql-eav.md",
    "docs/usage/sql-3nf.md",
    "docs/usage/sql-flat.md",
    "docs/usage/sql-functions.md",
    "docs/usage/in-memory.md",
    "docs/reference/builtins.md",
    "docs/reference/limits.md",
    "spec/",
    "examples/order-validation.sel",
    "examples/host-js.mjs",
    "examples/integration-js.mjs",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node tools/build-js-bundle.mjs",
    "prepublishOnly": "node tools/build-js-bundle.mjs",
    "test": "node js/bin/conformance.mjs && node js/bin/sqlt.mjs",
    "check": "tools/check.sh"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.12.0",
    "marked": "^16.4.2"
  }
}
