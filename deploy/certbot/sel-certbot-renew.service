# Installed as ~/.config/systemd/user/sel-certbot-renew.service; see README.md.
[Unit]
Description=Renew the sel.spelnianiemarzenspzoo.com certificate (certbot)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/snap/bin
ExecStart=%h/workspaces/nth/sel/deploy/certbot/certbot.sh renew
